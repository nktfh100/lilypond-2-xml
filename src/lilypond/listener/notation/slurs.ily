#(define xml-slur-count 0)
#(define xml-slur-originals '())
#(define (xml-clear-slurs!) (set! xml-slur-originals '()))
#(define (xml-reset-slurs!) (xml-clear-slurs!) (set! xml-slur-count 0))
#(define (xml-slur-number? value) (and (real? value) (finite? value)))
#(define (xml-slur-point? value)
   (and (pair? value) (xml-slur-number? (car value)) (xml-slur-number? (cdr value))))
#(define (xml-slur-noteheads grob side)
   (let* ((bound (ly:spanner-bound grob side #f))
          (heads (and (ly:grob? bound) (ly:grob-object bound 'note-heads #f)))
          (members (cond ((and (ly:grob? bound) (grob::has-interface bound 'note-head-interface)) (list bound))
                         ((ly:grob-array? heads) (ly:grob-array->list heads))
                         (else '()))))
     (delete-duplicates
      (filter-map (lambda (head)
        (let ((cause (ly:grob-property head 'cause #f)))
          (and (ly:stream-event? cause) (ly:event-property cause 'ed-note-id #f)
               (ly:grob? head) (grob::has-interface head 'note-head-interface)
               (cons (ly:event-property cause 'ed-note-id) head)))) members)
      (lambda (a b) (equal? (car a) (car b))))))
#(define (xml-slur-resolved-geometry entry systems row)
   (let* ((original (car entry)) (slur-id (cadr entry)) (staff-context (caddr entry))
          (pieces (xml-geometry-broken-pieces original)))
    (and (= (length pieces) 1)
     (let* ((grob (car pieces))
            (system (ly:grob-system grob))
            (system-index (and (ly:grob? system)
              (list-index (lambda (candidate) (eq? candidate system)) systems)))
            (from-heads (xml-slur-noteheads grob LEFT))
            (to-heads (xml-slur-noteheads grob RIGHT))
            (from (and (= (length from-heads) 1) (car from-heads)))
            (to (and (= (length to-heads) 1) (car to-heads)))
            (from-grob (and from (cdr from))) (to-grob (and to (cdr to)))
            (staff-entries (filter (lambda (row) (= (car row) staff-context)) xml-geometry-staff-symbols))
            (staff-pieces (if (= (length staff-entries) 1)
              (filter (lambda (candidate) (eq? (ly:grob-system candidate) system))
                (xml-geometry-broken-pieces (cdar staff-entries))) '()))
            (staff (and (= (length staff-pieces) 1) (car staff-pieces)))
            (stencil0 (ly:grob-property-data grob 'stencil))
            (stencil (if (ly:unpure-pure-container? stencil0)
                         (ly:unpure-pure-container-unpure-part stencil0) stencil0))
            (printed-controls (and (ly:stencil? stencil)
                                   (xml-curve-stencil-centerline (ly:stencil-expr stencil) 0 0 0)))
            (resolved-controls (or printed-controls
              (and (eq? (assoc-get 'custom-controls row #t) #f)
                (let* ((raw-controls (ly:grob-property grob 'control-points #f))
                       (controls (if (ly:unpure-pure-container? raw-controls)
                                     (ly:unpure-pure-container-unpure-part raw-controls) raw-controls)))
                  (and (list? controls) (= (length controls) 4)
                       (every xml-slur-point? controls) controls)))))
            (curve-origin (and (ly:grob? system)
              (cons (+ (ly:grob-relative-coordinate grob system X) (xml-geometry-render-extra grob X))
                    (+ (ly:grob-relative-coordinate grob system Y) (xml-geometry-render-extra grob Y)))))
            (points (and (list? resolved-controls) (= (length resolved-controls) 4)
              (every xml-slur-point? resolved-controls) (xml-slur-point? curve-origin)
              (map (lambda (point)
                (cons (+ (car curve-origin) (car point))
                (+ (cdr curve-origin) (cdr point)))) resolved-controls)))
            (from-stencil (and from-grob (ly:grob-property-data from-grob 'stencil)))
            (to-stencil (and to-grob (ly:grob-property-data to-grob 'stencil)))
            (from-extent (and (ly:stencil? from-stencil) (ly:stencil-extent from-stencil X)))
            (to-extent (and (ly:stencil? to-stencil) (ly:stencil-extent to-stencil X)))
            (from-origin (and from-grob from-extent (pair? from-extent)
              (cons (+ (ly:grob-relative-coordinate from-grob system X)
                       (xml-geometry-render-extra from-grob X) (car from-extent))
                    (+ (ly:grob-relative-coordinate from-grob system Y)
                       (xml-geometry-render-extra from-grob Y)))))
            (to-origin (and to-grob to-extent (pair? to-extent)
              (cons (+ (ly:grob-relative-coordinate to-grob system X)
                       (xml-geometry-render-extra to-grob X) (car to-extent))
                    (+ (ly:grob-relative-coordinate to-grob system Y)
                       (xml-geometry-render-extra to-grob Y)))))
            (positions (and (ly:grob? staff) (ly:grob-property-data staff 'line-positions)))
            (global-staff-space-mm (assoc-get 'staff-space ed-paper #f))
            (space (and (ly:grob? staff) (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f)))
            (local-staff-space (and (ly:grob? staff)
              (* (ly:grob-property staff 'staff-space 1) space)))
            (staff-scale (and (ly:grob? staff) (ly:grob-property staff 'staff-space 1)))
            (local-staff-space-mm (and (xml-slur-number? global-staff-space-mm)
              (xml-slur-number? staff-scale) (* global-staff-space-mm staff-scale)))
            (staff-top (and (ly:grob? staff) (pair? positions) (every xml-slur-number? positions)
              (+ (ly:grob-relative-coordinate staff system Y) (xml-geometry-render-extra staff Y)
                 (* .5 local-staff-space (apply max positions)))))
            (output-scale (and (ly:grob? system)
              (ly:output-def-lookup (ly:grob-layout system) 'output-scale #f))))
       (and system-index from to
         (eq? (assoc-get 'custom row #t) #f)
         (integer? (car from)) (> (car from) 0)
         (integer? (car to)) (> (car to) 0)
         (not (eq? from-grob to-grob))
         (eq? (ly:grob-system from-grob) system) (eq? (ly:grob-system to-grob) system)
         (ly:grob? staff) (eq? (ly:grob-system staff) system)
         (ly:stencil? from-stencil) (not (ly:stencil-empty? from-stencil))
         (ly:stencil? to-stencil) (not (ly:stencil-empty? to-stencil))
         points (every xml-slur-point? points)
         (xml-slur-point? curve-origin)
         (xml-slur-point? from-origin) (xml-slur-point? to-origin)
         (xml-slur-number? staff-top)
         (xml-slur-number? output-scale) (> output-scale 0)
         (xml-slur-number? space) (> space 0)
         (xml-slur-number? local-staff-space) (> local-staff-space 0)
         (xml-slur-number? global-staff-space-mm) (> global-staff-space-mm 0)
         (xml-slur-number? local-staff-space-mm) (> local-staff-space-mm 0)
         ; Original capture recorded the default controls/stencil and no custom callback.
         (not (eq? (ly:grob-property grob 'transparent #f) #t))
         `((slur-id . ,slur-id) (system . ,(+ system-index 1))
           (staff-context . ,staff-context) (from-note-id . ,(car from)) (to-note-id . ,(car to))
           (from-head-id . ,(car from)) (to-head-id . ,(car to))
           (staff-symbol-context . ,staff-context)
           (units . lilypond-final-layout-coordinates)
           (points . ,(list->vector (map (lambda (point) (vector (car point) (cdr point))) points)))
           (curve-origin . ,(vector (car curve-origin) (cdr curve-origin)))
           (from-note-origin . ,(vector (car from-origin) (cdr from-origin)))
           (to-note-origin . ,(vector (car to-origin) (cdr to-origin)))
           (staff-top-y . ,staff-top) (output-scale . ,output-scale)
           (layout-staff-space-mm . ,global-staff-space-mm)
           (local-staff-space-mm . ,local-staff-space-mm)
           (global-staff-space-mm . ,global-staff-space-mm)))))))
#(define (xml-final-slur-geometries)
   (let ((systems (if (ly:grob? xml-geometry-root-system) (xml-geometry-broken-pieces xml-geometry-root-system) '())))
    (for-each
     (lambda (entry)
      (let* ((id (cadr entry))
             (row (find (lambda (event) (and (eq? (assoc-get 'k event) 'slur)
                                             (= (assoc-get 'id event) id))) ed-events))
             (geometry (and row (xml-slur-resolved-geometry entry systems row))))
       (when geometry
        (set! ed-events
         (map (lambda (event)
          (if (and (eq? (assoc-get 'k event) 'slur) (= (assoc-get 'id event) id))
           (acons 'geometry geometry (filter (lambda (field) (not (eq? (car field) 'geometry))) event))
           event)) ed-events)))))
     (reverse xml-slur-originals))))
#(define (xml-slur-bound-notes grob side)
   (let* ((bound (ly:spanner-bound grob side #f))
          (heads (and (ly:grob? bound) (ly:grob-object bound 'note-heads)))
          (members (cond ((and (ly:grob? bound) (grob::has-interface bound 'note-head-interface)) (list bound))
                         ((ly:grob-array? heads) (ly:grob-array->list heads))
                         (else '()))))
     (list->vector
      (filter-map (lambda (head)
                    (let ((event (ly:grob-property head 'cause)))
                      (and (ly:stream-event? event) (ly:event-property event 'ed-note-id #f)))) members))))
#(define (xml-slur-engraver ctx)
   (let ((grobs '()))
     (make-engraver
      (acknowledgers
       ((slur-interface engraver grob source)
        (when (eq? ctx (ly:translator-context source))
          (set! grobs (cons (list grob (ly:context-current-moment ctx)) grobs)))))
      ((finalize engraver)
       (for-each
        (lambda (entry)
          (ed-guard 'slur
            (lambda ()
              (let* ((grob (car entry)) (fallback (cadr entry))
                     (left (xml-bracket-bound-moment grob LEFT))
                     (right (xml-bracket-bound-moment grob RIGHT))
                     (stencil (xml-bracket-stencil grob))
                     (name (assoc-get 'name (ly:grob-property grob 'meta)))
                     (raw-controls (ly:grob-property-data grob 'control-points))
                     (controls (if (ly:unpure-pure-container? raw-controls)
                                   (ly:unpure-pure-container-unpure-part raw-controls) raw-controls)))
                (set! xml-slur-count (+ xml-slur-count 1))
                (set! xml-slur-originals (cons (list grob xml-slur-count (xml-bracket-staff ctx)) xml-slur-originals))
                (set! ed-events
                  (cons
                   `((k . slur) (id . ,xml-slur-count)
                     (label . ,(ed-value (ly:grob-property grob 'spanner-id #f)))
                     (v . ,(ed-context-id ctx)) (s . ,(xml-bracket-staff ctx))
                     (phrasing . ,(eq? name 'PhrasingSlur))
                     (from . ,(xml-slur-bound-notes grob LEFT))
                     (to . ,(xml-slur-bound-notes grob RIGHT))
                     (from-head . ,(let ((b (ly:spanner-bound grob LEFT #f))) (and (ly:grob? b) (grob::has-interface b 'note-head-interface) #t)))
                     (to-head . ,(let ((b (ly:spanner-bound grob RIGHT #f))) (and (ly:grob? b) (grob::has-interface b 'note-head-interface) #t)))
                     (resolved-start . ,(ly:moment? left))
                     (m . ,(ly:moment-main (if (ly:moment? left) left fallback)))
                     (g . ,(ly:moment-grace (if (ly:moment? left) left fallback)))
                     (end-m . ,(if (ly:moment? right) (ly:moment-main right) 'null))
                     (end-g . ,(if (ly:moment? right) (ly:moment-grace right) 'null))
                     (direction . ,(xml-grob-direction grob 0))
                     (color . ,(xml-color (ly:grob-property grob 'color #f)))
                     (offset . ,(xml-bracket-pair grob 'extra-offset '(0 . 0)))
                     (dash . ,(ed-value (ly:grob-property grob 'dash-definition '())))
                     (controls . ,(if (list? controls) (ed-value controls) 'null))
                     (custom-controls . ,(not (eq? controls ly:slur::calc-control-points)))
                     (height-limit . ,(ly:grob-property grob 'height-limit 2))
                     (ratio . ,(ly:grob-property grob 'ratio 0.25))
                     (thickness . ,(ly:grob-property grob 'thickness 1.2))
                     (hidden . ,(or (eq? stencil #f) (eq? (ly:grob-property grob 'transparent #f) #t)))
                     (custom . ,(not (or (eq? stencil #f) (eq? stencil ly:slur::print)))))
                   ed-events))))))
        (reverse grobs))))))
\layout {
  \context { \Voice \consists #xml-slur-engraver }
  \context { \CueVoice \consists #xml-slur-engraver }
  \context { \DrumVoice \consists #xml-slur-engraver }
  \context { \TabVoice \consists #xml-slur-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state slurs semantic
 (xml-slur-count xml-slur-originals)
 (reset (xml-reset-slurs!))
 (clear (xml-clear-slurs!)))
