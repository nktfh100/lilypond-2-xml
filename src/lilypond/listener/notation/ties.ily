#(define xml-tie-count 0)
#(define xml-tie-originals '())
#(define (xml-reset-ties!) (set! xml-tie-originals '()))
#(define (xml-clear-ties!) (set! xml-tie-originals '()))
#(define (xml-tie-number? value) (and (real? value) (finite? value)))
#(define (xml-tie-point? value)
   (and (pair? value) (xml-tie-number? (car value)) (xml-tie-number? (cdr value))))
#(define (xml-tie-head-position head system)
   (let* ((staff-object (ly:grob-object head 'staff-symbol #f))
          (staff-pieces (if (ly:grob? staff-object)
            (filter (lambda (candidate) (eq? (ly:grob-system candidate) system))
              (xml-geometry-broken-pieces staff-object)) '()))
          (staff (and (= (length staff-pieces) 1) (car staff-pieces)))
          (owners (if (ly:grob? staff) (filter (lambda (entry)
            (or (eq? (cdr entry) staff) (eq? (cdr entry) (ly:grob-original staff)))) xml-geometry-staff-symbols) '()))
          (positions (and (ly:grob? staff) (ly:grob-property-data staff 'line-positions)))
          (space (and (ly:grob? staff) (ly:staff-symbol-staff-space staff)))
          (global-space (assoc-get 'staff-space ed-paper #f))
          (staff-scale (and (ly:grob? staff) (ly:grob-property staff 'staff-space 1)))
          (local-mm (and (xml-tie-number? global-space) (xml-tie-number? staff-scale) (* global-space staff-scale)))
          (top (and (ly:grob? staff) (pair? positions) (every xml-tie-number? positions)
            (xml-tie-number? space)
            (+ (ly:grob-relative-coordinate staff system Y) (xml-geometry-render-extra staff Y)
               (* .5 space (apply max positions)))))
          (stencil (ly:grob-property-data head 'stencil))
          (extent (and (ly:stencil? stencil) (ly:stencil-extent stencil X)))
          (origin (and (pair? extent) (xml-tie-number? (car extent))
            (cons (+ (ly:grob-relative-coordinate head system X) (xml-geometry-render-extra head X) (car extent))
                  (+ (ly:grob-relative-coordinate head system Y) (xml-geometry-render-extra head Y)))))
          (owner (and (= (length owners) 1) (caar owners))))
     (and (integer? owner) (ly:stencil? stencil) (not (ly:stencil-empty? stencil))
       (xml-tie-point? origin) (xml-tie-number? top) (xml-tie-number? local-mm) (> local-mm 0)
       `((owner . ,owner) (origin . ,origin) (top . ,top) (local-mm . ,local-mm)))))
#(define (xml-tie-stencil-centerline expression depth dx dy)
   (xml-curve-stencil-centerline expression depth dx dy))
#(define (xml-tie-resolved-geometry entry systems)
   (let* ((grob (car entry)) (row (cadr entry))
          (pieces (if (eq? (assoc-get 'kind row) 'normal) (xml-geometry-broken-pieces grob) '())))
     (and (eq? (assoc-get 'kind row) 'normal) (= (length pieces) 1)
       (let* ((piece (car pieces)) (system (ly:grob-system piece))
              (system-index (and (ly:grob? system) (list-index (lambda (candidate) (eq? candidate system)) systems)))
              (from (xml-slur-noteheads piece LEFT)) (to (xml-slur-noteheads piece RIGHT))
              (from-entry (and (= (length from) 1) (car from)))
              (to-entry (and (= (length to) 1) (car to)))
              (from-id (and from-entry (car from-entry))) (to-id (and to-entry (car to-entry)))
              (from-head (and from-entry (cdr from-entry))) (to-head (and to-entry (cdr to-entry)))
              (from-position (and from-head (xml-tie-head-position from-head system)))
              (to-position (and to-head (xml-tie-head-position to-head system)))
              (stencil0 (ly:grob-property-data piece 'stencil))
              (stencil (if (ly:unpure-pure-container? stencil0)
                           (ly:unpure-pure-container-unpure-part stencil0) stencil0))
              (raw0 (ly:grob-property-data piece 'control-points))
              (raw (if (ly:unpure-pure-container? raw0) (ly:unpure-pure-container-unpure-part raw0) raw0))
              (printed-controls (and (ly:stencil? stencil)
                                     (xml-tie-stencil-centerline (ly:stencil-expr stencil) 0 0 0)))
              (controls (or printed-controls
                (and (eq? (assoc-get 'custom-controls row #t) #f)
                     (list? raw) (= (length raw) 4) (every xml-tie-point? raw) raw)))
              (origin (and (ly:grob? system)
                (cons (+ (ly:grob-relative-coordinate piece system X) (xml-geometry-render-extra piece X))
                      (+ (ly:grob-relative-coordinate piece system Y) (xml-geometry-render-extra piece Y)))))
              (points (and (list? controls) (= (length controls) 4) (every xml-tie-point? controls)
                (xml-tie-point? origin)
                (map (lambda (point) (cons (+ (car origin) (car point)) (+ (cdr origin) (cdr point)))) controls)))
              (output-scale (and (ly:grob? system) (ly:output-def-lookup (ly:grob-layout system) 'output-scale #f)))
              (space (and (ly:grob? system) (ly:output-def-lookup (ly:grob-layout system) 'staff-space #f)))
              (global-space (assoc-get 'staff-space ed-paper #f)))
         (and system-index from-entry to-entry
           (integer? from-id) (integer? to-id) (> from-id 0) (> to-id 0)
           (= from-id (vector-ref (assoc-get 'from row) 0)) (= to-id (vector-ref (assoc-get 'to row) 0))
           (not (eq? from-head to-head))
           (eq? (ly:grob-system from-head) system) (eq? (ly:grob-system to-head) system)
           from-position to-position points (every xml-tie-point? points)
           (eq? (assoc-get 'custom row #t) #f)
           (eq? (assoc-get 'hidden row #t) #f)
           (xml-tie-number? output-scale) (> output-scale 0)
           (xml-tie-number? space) (> space 0)
           (xml-tie-number? global-space) (> global-space 0)
           (xml-tie-number? (assoc-get 'local-mm from-position))
           (xml-tie-number? (assoc-get 'local-mm to-position))
           `((tie-id . ,(assoc-get 'id row)) (system . ,(+ system-index 1))
             (from-note-id . ,from-id) (to-note-id . ,to-id) (from-head-id . ,from-id) (to-head-id . ,to-id)
             (from-staff-context . ,(assoc-get 'owner from-position)) (to-staff-context . ,(assoc-get 'owner to-position))
             (from-staff-symbol-context . ,(assoc-get 'owner from-position)) (to-staff-symbol-context . ,(assoc-get 'owner to-position))
             (units . lilypond-final-layout-coordinates)
             (points . ,(list->vector (map (lambda (point) (vector (car point) (cdr point))) points)))
             (curve-origin . ,(vector (car origin) (cdr origin)))
             (from-note-origin . ,(vector (car (assoc-get 'origin from-position)) (cdr (assoc-get 'origin from-position))))
             (to-note-origin . ,(vector (car (assoc-get 'origin to-position)) (cdr (assoc-get 'origin to-position))))
             (from-staff-top-y . ,(assoc-get 'top from-position)) (to-staff-top-y . ,(assoc-get 'top to-position))
             (output-scale . ,output-scale) (layout-staff-space-mm . ,global-space)
             (from-local-staff-space-mm . ,(assoc-get 'local-mm from-position))
             (to-local-staff-space-mm . ,(assoc-get 'local-mm to-position))
             (global-staff-space-mm . ,global-space)))))))
#(define (xml-final-ties)
   (let ((members (make-hash-table)))
     (when (ly:grob? xml-geometry-root-system)
       (for-each
        (lambda (system)
          (let ((elements (ly:grob-object system 'all-elements)))
            (when (ly:grob-array? elements)
              (for-each
               (lambda (g)
                 (when (and (grob::has-interface g 'tie-interface) (grob::is-live? g))
                   (let* ((original (or (ly:grob-original g) g))
                          (previous (hashq-ref members original '())))
                     (unless (memq g previous)
                       (hashq-set! members original (cons g previous))))))
               (ly:grob-array->list elements)))))
        (xml-geometry-broken-pieces xml-geometry-root-system)))
     (map
      (lambda (entry)
        (let* ((grob (car entry))
               (row (cadr entry))
               (actual (hashq-ref members (or (ly:grob-original grob) grob) '()))
               (geometry (xml-tie-resolved-geometry
                          entry (xml-geometry-broken-pieces xml-geometry-root-system)))
               (directions (map (lambda (g) (ly:grob-property-data g 'direction)) actual))
               (direction
                (if (and (pair? directions)
                         (every (lambda (d) (and (number? d) (or (= d UP) (= d DOWN))))
                                directions)
                         (every (lambda (d) (= d (car directions))) directions))
                    (car directions)
                    0)))
          (let ((updated
                 (acons 'direction direction
                        (filter (lambda (field) (not (eq? (car field) 'direction))) row))))
            (if geometry (acons 'geometry geometry updated) updated))))
      (reverse xml-tie-originals))))
#(define (xml-tie-head-id head)
   (let ((event (and (ly:grob? head) (ly:grob-property head 'cause))))
     (if (ly:stream-event? event)
         (let ((id (ly:event-property event 'ed-note-id #f))) (if id (vector id) #())) #())))
#(define (xml-tie-engraver ctx)
   (let ((grobs '()) (previous-wait 'unset))
     (make-engraver
      (acknowledgers
       ((tie-interface engraver grob source)
        (when (eq? ctx (ly:translator-context source))
          (set! grobs (cons (list grob (ly:context-current-moment ctx) (ly:grob-property-data grob 'control-points) (assoc-get 'name (ly:grob-property grob 'meta))) grobs)))))
      ((stop-translation-timestep engraver)
       (let ((wait (eq? (ly:context-property ctx 'tieWaitForNote #f) #t)))
         (unless (eq? wait previous-wait)
           (set! previous-wait wait)
           (ed-push! ctx `((k . tiestate) (v . ,(ed-context-id ctx)) (wait . ,wait))))))
      ((finalize engraver)
       (for-each
        (lambda (entry)
          (ed-guard 'tie
            (lambda ()
              (let* ((grob (car entry)) (fallback (cadr entry))
                     (name (cadddr entry))
                     (semi? (grob::has-interface grob 'semi-tie-interface))
                     (head (and semi? (ly:grob-object grob 'note-head)))
                     (column (and (ly:grob? head) (ly:item-get-column head)))
                     (left (if semi? (and (ly:grob? column) (ly:grob-property column 'when #f))
                                     (xml-bracket-bound-moment grob LEFT)))
                     (right (if semi? left (xml-bracket-bound-moment grob RIGHT)))
                     (stencil (xml-bracket-stencil grob))
                     (raw-controls (caddr entry))
                     (controls (if (ly:unpure-pure-container? raw-controls)
                                   (ly:unpure-pure-container-unpure-part raw-controls) raw-controls))
                     (details (ly:grob-property grob 'details '()))
                     (defaults (assoc-get name all-grob-descriptions)))
                (set! xml-tie-count (+ xml-tie-count 1))
                (let ((row
                   `((k . tiegraphic) (id . ,xml-tie-count)
                     (v . ,(ed-context-id ctx)) (s . ,(xml-bracket-staff ctx))
                     (kind . ,(cond ((eq? name 'RepeatTie) 'repeat) ((eq? name 'LaissezVibrerTie) 'laissez-vibrer) (else 'normal)))
                     (from . ,(if semi? (xml-tie-head-id head) (xml-slur-bound-notes grob LEFT)))
                     (to . ,(if semi? (xml-tie-head-id head) (xml-slur-bound-notes grob RIGHT)))
                     (resolved-start . ,(ly:moment? left))
                     (m . ,(ly:moment-main (if (ly:moment? left) left fallback)))
                     (g . ,(ly:moment-grace (if (ly:moment? left) left fallback)))
                     (end-m . ,(if (ly:moment? right) (ly:moment-main right) 'null))
                     (end-g . ,(if (ly:moment? right) (ly:moment-grace right) 'null))
                     (custom-controls . ,(not (eq? controls (if semi? ly:semi-tie::calc-control-points ly:tie::calc-control-points))))
                     (controls . ,(if (list? controls) (ed-value controls) 'null))
                     (custom-details . ,(not (equal? details (assoc-get 'details defaults))))
                     (direction . ,(let ((direction (ly:grob-property-data grob 'direction)))
                                     (if (number? direction) direction 0)))
                     (color . ,(xml-color (ly:grob-property grob 'color #f)))
                     (offset . ,(xml-bracket-pair grob 'extra-offset '(0 . 0)))
                     (dash . ,(ed-value (ly:grob-property grob 'dash-definition '())))
                     (thickness . ,(ly:grob-property grob 'thickness 1.2))
                     (line-thickness . ,(ly:grob-property grob 'line-thickness 0.8))
                     (hidden . ,(or (eq? stencil #f) (eq? (ly:grob-property grob 'transparent #f) #t)))
                     (custom . ,(not (or (eq? stencil #f) (eq? stencil ly:tie::print)))))))
                  (set! xml-tie-originals (cons (list grob row) xml-tie-originals))
                  (set! ed-events (cons row ed-events)))))))
        (reverse grobs))))))
\layout {
  \context { \Voice \consists #xml-tie-engraver }
  \context { \CueVoice \consists #xml-tie-engraver }
  \context { \DrumVoice \consists #xml-tie-engraver }
  \context { \TabVoice \consists #xml-tie-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state ties layout
 (xml-tie-count xml-tie-originals)
 (reset (set! xml-tie-count 0) (xml-reset-ties!))
 (clear (xml-clear-ties!)))
