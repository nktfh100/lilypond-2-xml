% Final, actual fingering-label connectors. No pitch-slide interpretation.
#(define-record-type <xml-finger-glide-entry>
   (make-xml-finger-glide-entry grob id voice staff moment stencil after-line-breaking)
   xml-finger-glide-entry?
   (grob xml-finger-glide-grob)
   (id xml-finger-glide-id)
   (voice xml-finger-glide-voice)
   (staff xml-finger-glide-staff)
   (moment xml-finger-glide-moment)
   (stencil xml-finger-glide-stencil)
   (after-line-breaking xml-finger-glide-after-line-breaking))
#(define xml-finger-originals '())
#(define xml-finger-labels '())
#(define xml-finger-notes '())
#(define xml-finger-count 0)
#(define xml-finger-label-count 0)
#(define (xml-clear-finger-glides!)
   (set! xml-finger-originals '())
   (set! xml-finger-labels '())
   (set! xml-finger-notes '()))
#(define (xml-reset-finger-glides!)
   (xml-clear-finger-glides!)
   (set! xml-finger-count 0)
   (set! xml-finger-label-count 0))
#(define (xml-finger-engraver ctx)
   (define (label grob source)
     (when (eq? ctx (ly:translator-context source))
       (set! xml-finger-label-count (+ 1 xml-finger-label-count))
       (set! xml-finger-labels (cons (cons grob xml-finger-label-count) xml-finger-labels))))
   (make-engraver
     (listeners
       ((note-event engraver event)
        (set! xml-finger-notes (cons event xml-finger-notes))))
     (acknowledgers
       ((finger-interface engraver grob source) (label grob source))
       ((string-number-interface engraver grob source) (label grob source))
       ((stroke-finger-interface engraver grob source) (label grob source))
       ((finger-glide-interface engraver grob source)
        (when (eq? ctx (ly:translator-context source))
          (set! xml-finger-count (+ xml-finger-count 1))
          (xml-geometry-observe-root! ctx)
          (set! xml-finger-originals
            (cons (make-xml-finger-glide-entry
                    grob
                    xml-finger-count
                    (ed-context-id ctx)
                    (ed-context-id (xml-script-staff ctx))
                    (ly:context-current-moment ctx)
                    (xml-bracket-stencil grob)
                    (ly:grob-property-data grob 'after-line-breaking))
                  xml-finger-originals)))))
     ((stop-translation-timestep engraver)
      (xml-observe-line-measure! ctx))))

#(define (xml-finger-note-ids label)
   (if (not (ly:grob? label)) #()
     (let* ((original (ly:grob-original label))
            (grob (if (ly:grob? original) original label))
            (cause (ly:grob-property grob 'cause #f))
            (music (and (ly:stream-event? cause) (ly:event-property cause 'music-cause #f)))
            (direct (filter-map (lambda (event)
              (let ((note-music (ly:event-property event 'music-cause #f)))
                (and (ly:stream-event? cause)
                  (or (memq cause (ly:event-property event 'articulations '()))
                    (and (ly:music? music) (ly:music? note-music)
                         (memq music (ly:music-property note-music 'articulations '()))))
                  (ly:event-property event 'ed-note-id #f)))) xml-finger-notes))
            (array (ly:grob-object grob 'side-support-elements #f))
            (heads (if (ly:grob-array? array)
              (filter (lambda (head) (grob::has-interface head 'note-head-interface))
                      (ly:grob-array->list array)) '()))
            (supported (delete-duplicates (filter-map (lambda (head)
              (let ((event (ly:grob-property head 'cause #f)))
                (and (ly:stream-event? event) (ly:event-property event 'ed-note-id #f)))) heads)))
            (specific (filter (lambda (id) (memv id supported)) direct)))
       ;; A Music articulation can be shared by multiple unfold executions;
       ;; intersect its identity with actual NoteHead supports, never event order.
       (list->vector (delete-duplicates (cond
         ((pair? specific) specific)
         ((= (length supported) 1) supported)
         ((= (length direct) 1) direct)
         (else '())))))))
#(define (xml-finger-label label)
   (if (not (ly:grob? label)) 'null
     (let* ((original (ly:grob-original label))
            (grob (if (ly:grob? original) original label))
            (id (assq-ref xml-finger-labels grob)))
       (if (not id) 'null
         `((id . ,id)
           (kind . ,(assoc-get 'name (ly:grob-property grob 'meta)))
           (text . ,(let ((text (ly:grob-property grob 'text "")))
                      (if (markup? text) (ed-markup->string text) "")))
           (note-ids . ,(xml-finger-note-ids grob)))))))
#(define (xml-final-finger-glides)
   (append-map
     (lambda (entry)
       (let* ((original (xml-finger-glide-grob entry))
              (staff-id (xml-finger-glide-staff entry))
              (from-label (xml-finger-label (ly:spanner-bound original LEFT #f)))
              (to-label (xml-finger-label (ly:spanner-bound original RIGHT #f)))
              (piece 0))
         (map (lambda (grob)
           (set! piece (+ piece 1))
           (let* ((left (xml-duration-bound (ly:spanner-bound grob LEFT #f)))
                  (right (xml-duration-bound (ly:spanner-bound grob RIGHT #f)))
                  (start (and left (cadr left)))
                  (end (and right (cadr right)))
                  (moment (if (ly:moment? start)
                              start
                              (xml-finger-glide-moment entry)))
                  (raw (xml-finger-glide-stencil entry))
                  (after (xml-finger-glide-after-line-breaking entry))
                  (custom (or (not (or (eq? raw #f) (eq? raw finger-glide::print)))
                              (not (or (eq? after #f) (null? after)))))
                  (stencil (ly:grob-property grob 'stencil #f))
                  (system (ly:grob-system grob))
                  (points (and (not custom) (ly:stencil? stencil)
                    (xml-line-points (ly:stencil-expr stencil) 0 0)))
                  (layout-space (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f))
                  (scale (and (number? layout-space) (> layout-space 0) (/ 10 layout-space)))
                  (staff (xml-geometry-unique-staff system staff-id))
                  (top (xml-geometry-staff-top staff system))
                  (origins (list (xml-line-origin system start staff-id)
                                 (xml-line-origin system end staff-id)))
                  (x (if (and points scale (ly:grob? system))
                    (map (lambda (point origin) (if origin (* scale
                      (- (+ (car point) (ly:grob-relative-coordinate grob system X)
                            (xml-geometry-render-extra grob X))
                         (ly:grob-relative-coordinate (car origin) system X))) 'null)) points origins)
                    '(null null)))
                  (y (if (and points scale top (ly:grob? system))
                    (map (lambda (point) (* scale (- (+ (cdr point)
                      (ly:grob-relative-coordinate grob system Y) (xml-geometry-render-extra grob Y)) top))) points)
                    '(null null))))
             `((k . fingerglide)
               (id . ,(xml-finger-glide-id entry))
               (piece . ,piece)
               (voice . ,(xml-finger-glide-voice entry))
               (s . ,staff-id)
               (m . ,(ly:moment-main moment))
               (g . ,(ly:moment-grace moment))
               (resolved-start . ,(ly:moment? start))
               (end-m . ,(if (ly:moment? end) (ly:moment-main end) 'null))
               (end-g . ,(if (ly:moment? end) (ly:moment-grace end) 'null))
               (left-kind . ,(if left (car left) 'null))
               (right-kind . ,(if right (car right) 'null))
               (from-notes . ,(if (list? from-label) (assoc-get 'note-ids from-label #()) #()))
               (to-notes . ,(if (list? to-label) (assoc-get 'note-ids to-label #()) #()))
               (from-label . ,from-label)
               (to-label . ,to-label)
               (style . ,(ed-value (ly:grob-property grob 'style 'line)))
               (color . ,(xml-color (ly:grob-property grob 'color #f)))
               (hidden . ,(or (eq? raw #f) (not (grob::is-live? grob))
                 (eq? (ly:grob-property grob 'transparent #f) #t)
                 (not (ly:stencil? stencil)) (and (ly:stencil? stencil) (ly:stencil-empty? stencil))))
               (custom . ,custom)
               (x-tenths . ,(list->vector x))
               (y-tenths . ,(list->vector y))
               (x-ref-m . ,(list->vector (map (lambda (o) (if o (ly:moment-main (cdr o)) 'null)) origins)))
               (x-ref-g . ,(list->vector (map (lambda (o) (if o (ly:moment-grace (cdr o)) 'null)) origins)))
               (staff-space . ,(ly:staff-symbol-staff-space grob))
               (layout-staff-space . ,(or layout-space 'null))
               (dash-fraction . ,(ly:grob-property grob 'dash-fraction .4))
               (dash-period . ,(ly:grob-property grob 'dash-period 1)))))
           (xml-geometry-broken-pieces original))))
     (reverse xml-finger-originals)))
\layout {
  \context { \Voice \consists #xml-finger-engraver }
  \context { \CueVoice \consists #xml-finger-engraver }
  \context { \DrumVoice \consists #xml-finger-engraver }
  \context { \TabVoice \consists #xml-finger-engraver }
  \context { \Staff \consists #xml-finger-engraver }
  \context { \TabStaff \consists #xml-finger-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state finger-glides layout
 (xml-finger-originals xml-finger-labels xml-finger-notes xml-finger-count xml-finger-label-count)
 (reset (xml-reset-finger-glides!))
 (clear (xml-clear-finger-glides!)))
