#(set-object-property! 'xml-figure-id 'music-type? integer?)
#(set-object-property! 'xml-figure-id 'music-doc "The extracted figured-bass identifier.")
#(define xml-figure-id 0)
% Capture the number-markup base before formatter steps; staff-height is in mm.
#(define (xml-figure-number-font-context layout props)
   (let* ((name (chain-assoc-get 'font-name props #f))
          (size (chain-assoc-get 'font-size props 0))
          (named (string? name))
          (family (chain-assoc-get 'font-family props #f))
          (music-family (if (or (not family) (memq family '(serif sans typewriter)))
                            'music family))
          (fonts (chain-assoc-get 'fonts props '()))
          (music-name (assoc-get music-family fonts #f))
          (reference (if named (ly:output-def-lookup layout 'text-font-size 11)
                         (* (ly:output-def-lookup layout 'staff-height) (/ 72.27 25.4)))))
     `((encoding . ,(if named "latin1" "fetaText"))
       (reference . ,reference)
       (attrs . ((font-size . ,(* reference (magstep size)))
                 (font-family . ,(if named name
                     (if (string? music-name) music-name "LilyPond Serif")))
                 (font-weight . "normal") (font-style . "normal")))
       (unsupported . ,(list->vector
          (cond (named (list (format #f "font-name=~a (Pango description)" name)))
                ((not (string? music-name))
                 (list (format #f "font-family=~a (unresolved music family)" music-family)))
                (else '())))))))
% Retain mutable event fields until all engraver finalizers have completed.
#(define xml-figure-columns '())
#(define xml-figure-column-systems (make-hash-table))
#(define xml-figure-positions '())
#(define (xml-figure-finite-number? value)
   (and (real? value) (finite? value)))
% Match Paper_column::is_used in the pinned compiler after translation.
#(define (xml-figure-column-eligible? column)
   (or (any (lambda (property)
              (let ((array (ly:grob-object column property)))
                (and (ly:grob-array? array) (pair? (ly:grob-array->list array)))))
            '(elements bounded-by-me))
       (symbol? (ly:grob-property column 'line-break-permission #f))
       (eq? (ly:grob-property column 'used #f) #t)
       (pair? (ly:grob-property column 'labels '()))))
% System::used_columns_in_range excludes columns after its last breakable one.
#(define (xml-figure-selected-columns system)
   (or (hashq-ref xml-figure-column-systems system #f)
       (let ((array (ly:grob-object system 'columns)))
         (and (ly:grob-array? array)
              (let* ((columns (ly:grob-array->list array))
                     (last-breakable (find (lambda (column)
                       (symbol? (ly:grob-property column 'line-break-permission #f)))
                       (reverse columns)))
                     (last-index (and last-breakable (list-index (lambda (column)
                       (eq? column last-breakable)) columns)))
                     (selected (if last-index
                       (filter xml-figure-column-eligible? (take columns (+ last-index 1))) '())))
                (hashq-set! xml-figure-column-systems system selected)
                selected)))))
#(define (xml-figure-column-used? column)
   (let* ((system (ly:grob-parent column X))
          (columns (and (ly:grob? system)
            (eq? (assoc-get 'name (ly:grob-property system 'meta)) 'System)
            (xml-figure-selected-columns system))))
     (if (list? columns) (and (memq column columns) #t) 'null)))
#(define (xml-figure-column item)
   (let loop ((grob item) (seen '()))
     (cond
      ((not (ly:grob? grob)) 'null)
      ((memq grob seen) #f)
      ((grob::has-interface grob 'paper-column-interface)
       (let ((moment (ly:grob-property grob 'when #f)))
         (and (ly:moment? moment)
              `((m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
                (used . ,(xml-figure-column-used? grob))))))
      ((eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'System) 'null)
      ; A spanner parent can acquire a broken system through its bounds, even
      ; without an Item paper column. Do not infer absence for that ancestry.
      ((not (ly:item? grob)) #f)
      (else (loop (ly:grob-parent grob X) (cons grob seen))))))
#(define (xml-figure-markup-command value)
   (and (pair? value) (procedure? (car value)) (procedure-name (car value))))
#(define (xml-figure-number-markup? value expected)
   (let ((args (and (eq? (xml-figure-markup-command value) 'number-markup) (cdr value))))
     (and (list? args) (= (length args) 1) (string? (car args))
          (equal? (car args) expected))))
#(define (xml-figure-number-base? value figure)
   (let* ((command (xml-figure-markup-command value)) (args (and command (cdr value)))
          (expected (and (integer? figure) (number->string figure 10))))
     (and expected
       (cond
        ((eq? command 'number-markup) (xml-figure-number-markup? value expected))
        ((eq? command 'align-on-other-markup)
         (and (list? args) (= (length args) 5)
              (xml-figure-number-markup? (list-ref args 2) "1")
              (xml-figure-number-markup? (list-ref args 4) expected)))
        (else #f)))))
#(define (xml-figure-accessory-markup? value)
   (let* ((command (xml-figure-markup-command value)) (args (and command (cdr value))))
     (cond
      ((eq? command 'number-markup)
       (and (list? args) (= (length args) 1) (string? (car args))))
      ((eq? command 'pad-x-markup)
       (and (list? args) (= (length args) 2) (number? (car args)) (= (car args) 0.1)
            (xml-figure-accessory-markup? (cadr args))))
      (else #f))))
#(define (xml-figure-markup-roles value event)
   ;; Match only the pinned default formatter's plain number, 10+ number, and
   ;; one put-adjacent number modifier forms. Unknown wrappers remain unpositioned.
   (let* ((command (xml-figure-markup-command value))
          (args (and command (cdr value)))
          (figure (and (ly:stream-event? event) (ly:event-property event 'figure #f)))
          (alteration (and (ly:stream-event? event) (ly:event-property event 'alteration #f)))
          (augmented (and (ly:stream-event? event) (eq? (ly:event-property event 'augmented #f) #t)))
          (diminished (and (ly:stream-event? event) (eq? (ly:event-property event 'diminished #f) #t)))
          (augmented-slash (and (ly:stream-event? event) (eq? (ly:event-property event 'augmented-slash #f) #t)))
          (alteration-bracket (and (ly:stream-event? event) (eq? (ly:event-property event 'alteration-bracket #f) #t))))
     (cond
      ((eq? command 'fontsize-markup)
       (and (list? args) (= (length args) 2) (equal? (car args) -5)
            (xml-figure-markup-roles (cadr args) event)))
      ((xml-figure-number-base? value figure)
       (and (not augmented) (not alteration) (not diminished) (not augmented-slash)
            (not alteration-bracket) '(number)))
      ((eq? command 'align-on-other-markup)
       (and (not augmented) (not alteration) (not diminished) (not augmented-slash)
            (not alteration-bracket) (xml-figure-number-base? value figure) '(number)))
      ((eq? command 'put-adjacent-markup)
       (and (list? args) (= (length args) 4) (eqv? (car args) X)
            (memv (cadr args) (list LEFT RIGHT))
            (xml-figure-number-base? (caddr args) figure)
            (xml-figure-accessory-markup? (cadddr args))
            (not diminished) (not augmented-slash) (not alteration-bracket)
            (let ((has-alteration (number? alteration)))
              (and (not (eq? has-alteration augmented))
                   (if (eq? has-alteration #t)
                       (if (eqv? (cadr args) LEFT) '(prefix number) '(number suffix))
                       (if (eqv? (cadr args) LEFT) '(prefix number) '(number suffix)))))))
      (else #f))))
#(define (xml-figure-stencil-glyph-origins expression)
   (let walk ((node expression) (x 0) (y 0))
     (if (not (pair? node)) #f
       (cond
        ((eq? (car node) 'translate-stencil)
         (let ((offset (and (pair? (cdr node)) (cadr node))))
           (and (pair? offset) (xml-figure-finite-number? (car offset))
                (xml-figure-finite-number? (cdr offset)) (pair? (cddr node))
                (walk (caddr node) (+ x (car offset)) (+ y (cdr offset))))))
        ((eq? (car node) 'combine-stencil)
         (let ((children (map (lambda (child) (walk child x y)) (cdr node))))
           (and (pair? children) (every list? children) (apply append children))))
        ((eq? (car node) 'glyph-string) (list (vector x y)))
        (else #f)))))
#(define (xml-figure-token-origins item stencil scale standard-formatter? custom-stencil?)
   (let* ((event (ly:grob-property-data item 'cause))
          (markup (ly:grob-property item 'text #f))
          (roles (and standard-formatter? (not custom-stencil?)
                      (markup? markup) (xml-figure-markup-roles markup event)))
          (origins (and roles (ly:stencil? stencil)
                        (xml-figure-stencil-glyph-origins (ly:stencil-expr stencil)))))
     (and roles origins (= (length roles) (length origins))
          (= (length (delete-duplicates roles)) (length roles))
          (every (lambda (point) (and (vector? point) (= (vector-length point) 2)
            (xml-figure-finite-number? (* scale (vector-ref point 0)))
            (xml-figure-finite-number? (* scale (vector-ref point 1))))) origins)
          (map (lambda (role point)
                 (cons role (vector (* scale (vector-ref point 0)) (* scale (vector-ref point 1)))))
               roles origins))))
#(define (xml-figure-resolved-position item staff-context standard-formatter? custom-stencil?)
   ;; Read only cached post-layout data. Keep the raw event in the source layout's
   ;; system/staff frame; consumers can join measure-layout by exact system/staff/moment.
   (let* ((system (ly:grob-system item))
          (systems (if (ly:grob? xml-geometry-root-system)
                       (xml-geometry-broken-pieces xml-geometry-root-system) '()))
          (system-index (and (ly:grob? system)
            (list-index (lambda (candidate) (eq? candidate system)) systems)))
          (layout (ly:grob-layout item))
          (layout-space (ly:output-def-lookup layout 'staff-space #f))
          (scale (and (xml-figure-finite-number? layout-space) (> layout-space 0) (/ 10 layout-space)))
          (column-info (xml-figure-column item))
          (column (xml-figure-column-grob item))
          (staff-candidates (if (and system (number? staff-context))
            (filter (lambda (candidate) (eq? (ly:grob-system candidate) system))
              (append-map (lambda (entry) (xml-geometry-broken-pieces (cdr entry)))
                (filter (lambda (entry) (= (car entry) staff-context)) xml-geometry-staff-symbols))) '()))
          (staff (and (= (length staff-candidates) 1) (car staff-candidates)))
          (positions (and staff (ly:grob-property-data staff 'line-positions)))
          (staff-layout-space (and staff
            (ly:output-def-lookup (ly:grob-layout staff) 'staff-space #f)))
          (staff-space (and staff (xml-figure-finite-number? staff-layout-space)
            (* (ly:grob-property staff 'staff-space 1) staff-layout-space)))
          (line-top (and staff (pair? positions) (every xml-figure-finite-number? positions)
            (+ (ly:grob-relative-coordinate staff system Y) (xml-geometry-render-extra staff Y)
               (* 0.5 staff-space (apply max positions)))))
          (item-x (and scale system (* scale (+ (ly:grob-relative-coordinate item system X)
                                                  (xml-geometry-render-extra item X)))))
          (item-y (and scale system line-top (* scale (- (+ (ly:grob-relative-coordinate item system Y)
                                                              (xml-geometry-render-extra item Y)) line-top))))
          (item-system-y (and scale system (* scale (+ (ly:grob-relative-coordinate item system Y)
                                                        (xml-geometry-render-extra item Y)))))
          (staff-top-system-y (and scale system line-top (* scale line-top)))
          (column-x (and scale system column
            (* scale (+ (ly:grob-relative-coordinate column system X) (xml-geometry-render-extra column X)))))
          (stencil (ly:grob-property-data item 'stencil))
          (live (and (ly:stencil? stencil) (grob::is-live? item)))
          (x-extent (and live (ly:stencil-extent stencil X)))
          (y-extent (and live (ly:stencil-extent stencil Y)))
          (token-origins (and scale (xml-figure-token-origins item stencil scale standard-formatter? custom-stencil?)))
          (valid? (and system-index scale column-info column staff line-top (xml-figure-finite-number? staff-space)
                       (xml-figure-finite-number? item-x) (xml-figure-finite-number? item-y) (xml-figure-finite-number? column-x)
                       (pair? x-extent) (pair? y-extent)
                       (xml-figure-finite-number? (car x-extent)) (xml-figure-finite-number? (cdr x-extent))
                       (xml-figure-finite-number? (car y-extent)) (xml-figure-finite-number? (cdr y-extent))
                       (xml-figure-finite-number? item-system-y)
                       (xml-figure-finite-number? staff-top-system-y))))
     (and valid?
       `((units . layout-staff-space-tenths)
         (system . ,(+ system-index 1)) (staff-context . ,staff-context)
         (column-m . ,(ly:moment-main (ly:grob-property-data column 'when)))
         (column-g . ,(ly:moment-grace (ly:grob-property-data column 'when)))
         (column-used . ,(assoc-get 'used column-info))
         (system-x-tenths . ,item-x) (column-x-tenths . ,column-x)
         (item-column-x-tenths . ,(- item-x column-x)) (system-y-tenths . ,item-system-y)
         (staff-top-system-y-tenths . ,staff-top-system-y) (y-tenths . ,item-y)
         (stencil-x-tenths . ,(vector (* scale (car x-extent)) (* scale (cdr x-extent))))
         (stencil-y-tenths . ,(vector (* scale (car y-extent)) (* scale (cdr y-extent))))
         (layout-staff-space . ,layout-space)
         (local-staff-space . ,staff-space)
         (output-scale . ,(ly:output-def-lookup layout 'output-scale #f))
         (stencil-live . #t)
         ,@(if token-origins `((tokens . ,token-origins)) '())))))
#(define (xml-figure-column-grob item)
   (let loop ((grob item) (seen '()))
     (cond ((not (ly:grob? grob)) #f)
           ((memq grob seen) #f)
           ((grob::has-interface grob 'paper-column-interface) grob)
           ((eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'System) #f)
           (else (loop (ly:grob-parent grob X) (cons grob seen))))))
#(define (xml-finish-figure-positions!)
   (for-each
    (lambda (entry)
      (let ((resolved (catch #t
          (lambda () (xml-figure-resolved-position (car entry) (caddr entry) (cadddr entry) (car (cddddr entry))))
          (lambda (key . args) #f))))
       (set-cdr! (cadr entry) (or resolved 'null))))
    xml-figure-positions)
   (set! xml-figure-positions '()))
#(define (xml-clear-figure-positions!)
   (for-each (lambda (entry) (set-cdr! (cadr entry) 'null)) xml-figure-positions))
% Column ownership is available at score finalization; positions wait until
% xml-finish-final-layout! has completed the actual page/system formatting.
#(define (xml-finish-figure-columns!)
   (for-each
    (lambda (entry)
      (ed-guard 'figured-bass-column
        (lambda () (set-cdr! (cdr entry) (xml-figure-column (car entry))))))
    xml-figure-columns)
   (xml-clear-figure-positions!)
   (set! xml-figure-columns '())
   (set! xml-figure-column-systems (make-hash-table)))
#(define (xml-figure-staves ctx)
   (if (memq (ly:context-name ctx) '(Staff TabStaff DrumStaff RhythmicStaff))
       (list ctx)
       (append-map xml-figure-staves (ly:context-children ctx))))
#(define (xml-figure-association ctx)
   (let loop ((parent ctx))
     (cond
      ((not (ly:context? parent)) (cons #f 0))
      ((memq (ly:context-name parent) '(Staff TabStaff DrumStaff RhythmicStaff))
       (cons (ed-context-id parent) (or (ed-grob-property parent 'BassFigureAlignmentPositioning 'direction) 1)))
      ((eq? (ly:context-name parent) 'FiguredBass)
       (let* ((outer (ly:context-parent parent))
              (above (ly:context-property ctx 'alignAboveContext ""))
              (below (ly:context-property ctx 'alignBelowContext ""))
              (staves (xml-figure-staves outer))
              (target (find (lambda (s) (or (and (string? above) (not (string-null? above)) (equal? above (ly:context-id s)))
                                            (and (string? below) (not (string-null? below)) (equal? below (ly:context-id s))))) staves))
              (siblings (ly:context-children outer))
              (before (append-map xml-figure-staves (take-while (lambda (s) (not (eq? s parent))) siblings))))
         (cond
          (target (cons (ed-context-id target) (if (equal? above (ly:context-id target)) 1 -1)))
          ((pair? before) (cons (ed-context-id (last before)) -1))
          ((pair? staves) (if (eq? (car staves) outer) (loop outer) (cons (ed-context-id (car staves)) 1)))
          (else (cons #f 0)))))
      (else (loop (ly:context-parent parent))))))
#(define (xml-figured-bass-engraver ctx)
   (let ((events '()) (items '()) (lines '()) (length #f) (skip #f) (active #f))
     (make-engraver
      (listeners
       ((bass-figure-event engraver event)
        (set! xml-figure-id (+ xml-figure-id 1))
        (ly:event-set-property! event 'xml-figure-id xml-figure-id)
        (set! active #t)
        (set! events (cons event events))
        (set! length (ly:event-property event 'duration)))
       ((skip-event engraver event)
        (set! skip #t) (set! length (ly:event-property event 'duration)))
       ((rest-event engraver event)
        (set! skip #t) (set! length (ly:event-property event 'duration))))
      (acknowledgers
       ((bass-figure-interface engraver item source-engraver)
        (set! items (cons item items)))
       ((horizontal-line-spanner-interface engraver item source-engraver)
        (when (eq? (assoc-get 'name (ly:grob-property item 'meta)) 'BassFigureContinuation)
          (set! lines (cons item lines)))))
      ((stop-translation-timestep engraver)
       (when (and length (or (pair? events) (and skip (or active (eq? (ly:context-name ctx) 'FiguredBass)))))
         (let ((association (xml-figure-association ctx)))
           (ed-push! ctx
             `((k . figuredbass) (v . ,(ed-context-id ctx)) (graphics-captured . ,(every (lambda (item)
                 (let ((cause (ly:grob-property item 'cause)))
                   (and (ly:stream-event? cause) (integer? (ly:event-property cause 'xml-figure-id #f))))) items))
               (s . ,(or (car association) 'null)) (direction . ,(cdr association))
               (d . ,(ed-duration length)) (skip . ,skip)
               (alt-direction . ,(ly:context-property ctx 'figuredBassAlterationDirection -1))
               (plus-direction . ,(ly:context-property ctx 'figuredBassPlusDirection 1))
               (custom . ,(not (eq? (ly:context-property ctx 'figuredBassFormatter) format-bass-figure)))
               (figures . ,(list->vector
                 (map (lambda (event)
                   (append `((id . ,(ly:event-property event 'xml-figure-id))
                             (markup . ,(let ((text (ly:event-property event 'text #f))) (if (markup? text) (xml-markup-tree text) #f))))
                     (map (lambda (property) (cons property (ed-value (ly:event-property event property #f))))
                       '(figure alteration augmented diminished augmented-slash bracket-start bracket-stop alteration-bracket no-continuation text))))
                   (reverse events))))))))
       (for-each
        (lambda (item)
          (let* ((event (ly:grob-property item 'cause))
                 (id (and (ly:stream-event? event) (ly:event-property event 'xml-figure-id #f)))
                 (line (ly:grob-parent item Y))
                 (alignment (and (ly:grob? line) (ly:grob-parent line Y)))
                 (rows (and (ly:grob? alignment) (ly:grob-object alignment 'elements)))
                 (column (cons 'column #f))
                 (position (cons 'position #f))
                 (association (xml-figure-association ctx)))
            (when id
              (set! xml-figure-columns (cons (cons item column) xml-figure-columns))
              (let ((stencil (ly:grob-property-data item 'stencil)))
                (set! xml-figure-positions (cons (list item position (car association)
                  (eq? (ly:context-property ctx 'figuredBassFormatter) format-bass-figure)
                  (not (or (eq? stencil #f) (eq? stencil ly:text-interface::print)))) xml-figure-positions)))
              (ed-push! ctx `((k . figuregraphic) (id . ,id) ,column ,position
                (display . ,(xml-markup-tree (ly:grob-property item 'text #f)))
                (row . ,(if (and (ly:grob? line) (eq? (assoc-get 'name (ly:grob-property line 'meta)) 'BassFigureLine) (ly:grob-array? rows)) (list-index (lambda (r) (eq? r line)) (ly:grob-array->list rows)) #f))
                (color . ,(xml-color (ly:grob-property item 'color #f)))
                (font-context . ,(let ((layout (ly:grob-layout item)))
                  (xml-text-font-context layout
                    (ly:grob-alist-chain item (ly:output-def-lookup layout 'text-font-defaults)))))
                (number-font-context . ,(let ((layout (ly:grob-layout item)))
                  (xml-figure-number-font-context layout
                    (ly:grob-alist-chain item (ly:output-def-lookup layout 'text-font-defaults)))))
                (custom . ,(let ((stencil (ly:grob-property-data item 'stencil)))
                  (not (or (eq? stencil #f) (eq? stencil ly:text-interface::print)))))
                (hidden . ,(or (eq? (ly:grob-property-data item 'stencil) #f) (eq? (ly:grob-property item 'transparent #f) #t)))
                (implicit . ,(eq? (ly:grob-property item 'implicit #f) #t))) ))))
        (reverse items))
       (set! events '()) (set! items '()) (set! length #f) (set! skip #f))
      ((finalize engraver)
       (for-each
        (lambda (line)
          (ed-guard 'figured-bass-line
            (lambda ()
              (let* ((start (ly:grob-property (ly:spanner-bound line LEFT) 'cause))
                     (end (ly:grob-property (ly:spanner-bound line RIGHT) 'cause)))
                (when (and (ly:stream-event? start) (ly:stream-event? end))
                  (ed-push! ctx `((k . figureline)
                    (color . ,(xml-color (ly:grob-property line 'color #f)))
                    (offset . ,(xml-bracket-pair line 'extra-offset '(0 . 0)))
                    (hidden . ,(or (eq? (xml-bracket-stencil line) #f)
                                  (eq? (ly:grob-property line 'transparent #f) #t)))
                    (custom . ,(let ((stencil (xml-bracket-stencil line)))
                      (not (or (eq? stencil #f) (eq? stencil figured-bass-continuation::print)))))
                    (style . ,(ed-value (ly:grob-property line 'style 'line)))
                    (thickness . ,(ly:grob-property line 'thickness 1))
                    (from . ,(ly:event-property start 'xml-figure-id #f))
                    (to . ,(ly:event-property end 'xml-figure-id #f)))))))))
        (reverse lines))))))
\layout {
  \context { \FiguredBass \consists #xml-figured-bass-engraver }
  \context { \Staff \consists #xml-figured-bass-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state figured-bass semantic
 (xml-figure-id xml-figure-columns xml-figure-positions xml-figure-column-systems)
 (reset (set! xml-figure-id 0) (set! xml-figure-positions '()))
 (clear ))
