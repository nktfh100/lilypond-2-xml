% Ordinary brackets and historical replacement ligatures are different graphics.
#(define xml-ligature-originals '())
#(define xml-ligature-count 0)
#(define xml-ligature-print-values (make-hash-table))
#(define (xml-clear-ligatures!)
   (set! xml-ligature-originals '())
   (set! xml-ligature-print-values (make-hash-table)))
#(define (xml-reset-ligatures!)
   (xml-clear-ligatures!) (set! xml-ligature-count 0))
#(define (xml-ligature-pair grob property)
   (let ((value (ly:grob-property grob property #f)))
     (if (and (pair? value) (number? (car value)) (number? (cdr value)))
         (vector (car value) (cdr value)) 'null)))
% Bracket::make_bracket changes dashed-line to line before printing solid edges.
% Observe the actual standard print inputs without forcing property callbacks early.
#(define (xml-ligature-observe! grob property fallback observed)
   (define (save actual value)
     (hashq-set! observed actual
       (acons property value (hashq-ref observed actual '())))
     value)
   (define (observe actual value)
     (if (or (and (eq? property 'style) (or (symbol? value) (string? value)))
             (and (memq property '(dash-period dash-fraction)) (number? value))
             (and (eq? property 'dashed-edge) (boolean? value)))
         (save actual value)
         (begin (hashq-set! observed actual
                  (acons 'unsupported #t (hashq-ref observed actual '())))
                (save actual fallback))))
   (let ((raw (ly:grob-property-data grob property)))
     (if (procedure? raw)
         (ly:grob-set-property! grob property
           (lambda (actual)
             (let ((value (raw actual))) (observe actual value) value)))
         (observe grob (if (null? raw) fallback raw)))))
#(define (xml-ligature-print grob observed)
   (for-each (lambda (entry) (xml-ligature-observe! grob (car entry) (cdr entry) observed))
     '((style . line) (dash-fraction . 0.4) (dash-period . 1) (dashed-edge . #f)))
   (ly:tuplet-bracket::print grob))
#(define (xml-ligature-print-value grob property fallback)
   (let ((values (hashq-ref xml-ligature-print-values grob '())))
     (assoc-get property values fallback)))
#(define (xml-ligature-engraver ctx)
   (define (remember grob source names)
     (when (and (eq? ctx (ly:translator-context source))
                (memq (assoc-get 'name (ly:grob-property grob 'meta)) names))
       (set! xml-ligature-count (+ xml-ligature-count 1))
       (xml-geometry-observe-root! ctx)
       (set! xml-ligature-originals
         (cons (list grob xml-ligature-count (ed-context-id ctx)
                     (ed-context-id (xml-script-staff ctx))
                     (ly:context-current-moment ctx)
                     (xml-bracket-stencil grob)
                     (ly:grob-property-data grob 'after-line-breaking)
                     (assoc-get 'name (ly:grob-property grob 'meta)))
               xml-ligature-originals))
       (when (eq? (xml-bracket-stencil grob) ly:tuplet-bracket::print)
         (let ((observed xml-ligature-print-values))
           (ly:grob-set-property! grob 'stencil
             (lambda (actual) (xml-ligature-print actual observed)))))))
   (make-engraver
     (acknowledgers
       ((tuplet-bracket-interface engraver grob source)
        (remember grob source '(LigatureBracket)))
       ((font-interface engraver grob source)
        (remember grob source '(MensuralLigature VaticanaLigature KievanLigature))))))
#(define (xml-final-ligatures)
   (append-map
     (lambda (entry)
       (let ((piece 0))
         (map
           (lambda (grob)
             (set! piece (+ piece 1))
             (let* ((name (list-ref entry 7))
                    (ordinary (eq? name 'LigatureBracket))
                    (left (xml-duration-bound (ly:spanner-bound grob LEFT #f)))
                    (right (xml-duration-bound (ly:spanner-bound grob RIGHT #f)))
                    (start (and left (cadr left))) (end (and right (cadr right)))
                    (moment (if (ly:moment? start) start (list-ref entry 4)))
                    (raw (list-ref entry 5)) (after (list-ref entry 6))
                    (stencil (ly:grob-property grob 'stencil #f))
                    (system (ly:grob-system grob))
                    (printed (hashq-ref xml-ligature-print-values grob #f))
                    (positions (if (and ordinary printed) (xml-ligature-pair grob 'positions) 'null))
                    (space (ly:staff-symbol-staff-space grob))
                    (layout-space (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f))
                    (staff (xml-geometry-unique-staff system (list-ref entry 3)))
                    (top (xml-geometry-staff-top staff system))
                    (connect (if printed (ly:grob-property grob 'connect-to-neighbor '(#f . #f)) '(#f . #f)))
                    (edge-text (ly:grob-property grob 'edge-text #f))
                    (custom (and ordinary (or
                      (xml-ligature-print-value grob 'unsupported #f)
                      (not (or (eq? raw #f) (eq? raw ly:tuplet-bracket::print)))
                      (not (or (eq? after #f) (null? after)))
                      (and (pair? edge-text) (or (car connect) (cdr connect)))))))
               `((k . ligature) (id . ,(cadr entry)) (piece . ,piece) (name . ,name)
                 (voice . ,(caddr entry)) (s . ,(list-ref entry 3))
                 (m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
                 (resolved-start . ,(ly:moment? start))
                 (end-m . ,(if (ly:moment? end) (ly:moment-main end) 'null))
                 (end-g . ,(if (ly:moment? end) (ly:moment-grace end) 'null))
                 (left-kind . ,(if left (car left) 'null)) (from-notes . ,(if left (caddr left) #()))
                 (right-kind . ,(if right (car right) 'null)) (to-notes . ,(if right (caddr right) #()))
                 (direction . ,(xml-grob-direction grob 1))
                 (edges . ,(xml-bracket-pair grob 'edge-height '(0.7 . 0.7)))
                 (style . ,(ed-value (xml-ligature-print-value grob 'style 'line)))
                 (dash-fraction . ,(xml-ligature-print-value grob 'dash-fraction 0.4))
                 (dash-period . ,(xml-ligature-print-value grob 'dash-period 1))
                 (dashed-edges . ,(if (xml-ligature-print-value grob 'dashed-edge #f) #t #f))
                 (color . ,(xml-color (ly:grob-property grob 'color #f)))
                 (hidden . ,(or (eq? raw #f) (not (grob::is-live? grob))
                   (eq? (ly:grob-property grob 'transparent #f) #t)
                   (not (ly:stencil? stencil))
                   (and (ly:stencil? stencil) (ly:stencil-empty? stencil))))
                 (custom . ,(if custom #t #f)) (slur . ,(if (ly:grob-property grob 'tuplet-slur #f) #t #f))
                 (y-tenths . ,(if (and top (vector? positions) (number? layout-space)
                   (> layout-space 0) (ly:grob? system))
                   (list->vector (map (lambda (y)
                     (* 10 (/ (- (+ (ly:grob-relative-coordinate grob system Y)
                       y (xml-geometry-render-extra grob Y)) top) layout-space))) (vector->list positions))) 'null))
                 (positions . ,positions) (x-positions . ,(if (and ordinary printed) (xml-ligature-pair grob 'X-positions) 'null))
                 (staff-space . ,space) (layout-staff-space . ,(or layout-space 'null))
                 (extra-offset . ,(xml-bracket-pair grob 'extra-offset '(0 . 0)))
                 (flare . ,(xml-bracket-pair grob 'bracket-flare '(0 . 0)))
                 (shorten . ,(xml-bracket-pair grob 'shorten-pair '(-0.2 . -0.2)))
                 (connect . ,(vector (if (car connect) #t #f) (if (cdr connect) #t #f))))))
           (xml-geometry-broken-pieces (car entry)))))
     (reverse xml-ligature-originals)))
\layout {
  \context { \Voice \consists #xml-ligature-engraver }
  \context { \CueVoice \consists #xml-ligature-engraver }
  \context { \DrumVoice \consists #xml-ligature-engraver }
  \context { \TabVoice \consists #xml-ligature-engraver }
  \context { \VaticanaVoice \consists #xml-ligature-engraver }
  \context { \MensuralVoice \consists #xml-ligature-engraver }
  \context { \KievanVoice \consists #xml-ligature-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state ligatures layout
 (xml-ligature-originals xml-ligature-count xml-ligature-print-values)
 (reset (xml-reset-ligatures!))
 (clear (xml-clear-ligatures!)))
