% Surviving BendSpanners and their actual post-print target component states.
#(define xml-bend-originals '())
#(define xml-bend-count 0)
#(define (xml-clear-bends!) (set! xml-bend-originals '()))
#(define (xml-reset-bends!) (xml-clear-bends!) (set! xml-bend-count 0))
#(define (xml-bend-engraver ctx)
   (make-engraver
     (acknowledgers
       ((bend-interface engraver grob source)
        (when (and (eq? ctx (ly:translator-context source)) (ly:spanner? grob)
                   (eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'BendSpanner))
          (set! xml-bend-count (+ xml-bend-count 1))
          (xml-geometry-observe-root! ctx)
          (set! xml-bend-originals
            (cons (list grob xml-bend-count (ed-context-id ctx)
                        (ed-context-id (xml-script-staff ctx)) (ly:context-current-moment ctx)
                        (xml-bracket-stencil grob)
                        (ly:grob-property-data grob 'before-line-breaking)
                        (ly:grob-property-data grob 'after-line-breaking))
                  xml-bend-originals)))))))
#(define (xml-bend-hidden? grob)
   (if (not (ly:grob? grob)) 'null
     (let ((stencil (ly:grob-property grob 'stencil #f)))
       (or (not (grob::is-live? grob))
           (eq? (ly:grob-property grob 'transparent #f) #t)
           (not (ly:stencil? stencil))
           (and (ly:stencil? stencil) (ly:stencil-empty? stencil))))))
#(define (xml-bend-bound-heads original side)
   (let* ((bound (ly:spanner-bound original side #f))
          (array (and (ly:grob? bound) (ly:grob-object bound 'note-heads #f))))
     (if (ly:grob-array? array) (ly:grob-array->list array) '())))
#(define (xml-bend-eligible? head)
   ;; The source renderer uses no #f fallback: absent bend-me is SCM_EOL, truthy.
   (not (eq? (ly:grob-property head 'bend-me) #f)))
#(define (xml-bend-head-state head)
   (let* ((cause (ly:grob-property head 'cause #f))
          (stem (ly:grob-object head 'stem #f))
          (flag (and (ly:grob? stem) (ly:grob-object stem 'flag #f)))
          (beam (and (ly:grob? stem) (ly:grob-object stem 'beam #f)))
          (dots (ly:grob-object head 'dot #f)))
     `((nid . ,(if (ly:stream-event? cause) (ly:event-property cause 'ed-note-id 'null) 'null))
       (kind . ,(assoc-get 'name (ly:grob-property head 'meta) 'null))
       (eligible . ,(xml-bend-eligible? head))
       (hidden . ,(xml-bend-hidden? head))
       (parenthesized . ,(eq? (ly:grob-property head 'parenthesized #f) #t))
       (stem-hidden . ,(xml-bend-hidden? stem))
       (flag-hidden . ,(xml-bend-hidden? flag))
       (dots-hidden . ,(xml-bend-hidden? dots))
       (beam-hidden . ,(xml-bend-hidden? beam)))))
#(define (xml-bend-head-ids heads)
   (let* ((pitched (filter-map (lambda (head)
             (let* ((cause (ly:grob-property head 'cause #f))
                    (pitch (and (ly:stream-event? cause) (ly:event-property cause 'pitch #f))))
               (and (xml-bend-eligible? head) (ly:pitch? pitch) (cons head pitch)))) heads))
          (top (and (pair? pitched) (last (sort (map cdr pitched) ly:pitch<?)))))
     (list->vector (delete-duplicates (if (not top) '()
       (filter-map (lambda (entry)
         (and (= (ly:pitch-quartertones (cdr entry)) (ly:pitch-quartertones top))
           (ly:event-property (ly:grob-property (car entry) 'cause) 'ed-note-id #f))) pitched))))))
#(define (xml-bend-quarter-difference left right)
   (define (pitches heads)
     (filter-map (lambda (head)
       (and (xml-bend-eligible? head)
         (let ((cause (ly:grob-property head 'cause #f)))
           (and (ly:stream-event? cause)
             (let ((pitch (ly:event-property cause 'pitch #f)))
               (and (ly:pitch? pitch) pitch)))))) heads))
   (let ((a (pitches left)) (b (pitches right)))
     (if (and (pair? a) (pair? b))
         (- (ly:pitch-quartertones (last (sort b ly:pitch<?)))
            (ly:pitch-quartertones (last (sort a ly:pitch<?)))) 'null)))
#(define (xml-final-bends)
   ;; Rendering one bend can mutate heads shared with a later bend. Resolve every
   ;; actual piece FIRST, then snapshot component states consistently for all rows.
   (for-each (lambda (entry)
     (for-each (lambda (piece) (ly:grob-property piece 'stencil #f))
               (xml-geometry-broken-pieces (car entry)))) (reverse xml-bend-originals))
   (append-map
     (lambda (entry)
       (let* ((original (car entry))
              (from (xml-bend-bound-heads original LEFT))
              (to (xml-bend-bound-heads original RIGHT))
              (quarter-difference (xml-bend-quarter-difference from to))
              (piece 0))
         (map (lambda (grob)
           (set! piece (+ piece 1))
           (let* ((left (xml-duration-bound (ly:spanner-bound grob LEFT #f)))
                  (right (xml-duration-bound (ly:spanner-bound grob RIGHT #f)))
                  (start (and left (cadr left))) (end (and right (cadr right)))
                  (moment (if (ly:moment? start) start (list-ref entry 4)))
                  (raw (list-ref entry 5)) (before (list-ref entry 6)) (after (list-ref entry 7))
                  (details (ly:grob-property grob 'details '()))
                  (dash (assoc-get 'dashed-line-settings details #f))
                  (style (ly:grob-property grob 'style '()))
                  (text (ly:grob-property grob 'text #f))
                  (custom (or (not (or (eq? raw #f) (eq? raw bend-spanner::print)))
                    (not (or (eq? before #f) (null? before) (eq? before bend::target-cautionary)))
                    (not (or (eq? after #f) (null? after)))))
                  (level (assoc-get 'successive-level details #f)))
             `((k . bendgraphic) (id . ,(cadr entry)) (piece . ,piece)
               (voice . ,(caddr entry)) (s . ,(list-ref entry 3))
               (m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
               (resolved-start . ,(ly:moment? start))
               (end-m . ,(if (ly:moment? end) (ly:moment-main end) 'null))
               (end-g . ,(if (ly:moment? end) (ly:moment-grace end) 'null))
               (left-kind . ,(if left (car left) 'null)) (right-kind . ,(if right (car right) 'null))
               (from-notes . ,(xml-bend-head-ids from)) (to-notes . ,(xml-bend-head-ids to))
               (from-heads . ,(list->vector (map xml-bend-head-state from)))
               (to-heads . ,(list->vector (map xml-bend-head-state to)))
               (quarter-difference . ,quarter-difference)
               (style . ,(if (null? style) 'null (ed-value style)))
               (text . ,(if (markup? text) (ed-markup->string text)
                 (if (number? quarter-difference) (bend::text-string grob) "")))
               (text-custom . ,(not (eq? text #f)))
               (font-context . ,(xml-name-font-context grob))
               (color . ,(xml-color (ly:grob-property grob 'color #f)))
               (hidden . ,(or (eq? raw #f) (xml-bend-hidden? grob)))
               (custom . ,custom)
               (successive-level . ,(if (number? level) level 'null))
               (dash-settings . ,(if (and (list? dash) (= (length dash) 3) (every number? dash))
                                       (list->vector dash) 'null))
               (staff-space . ,(ly:staff-symbol-staff-space grob))
               (layout-staff-space . ,(ly:output-def-lookup (ly:grob-layout grob) 'staff-space 'null)))))
           (xml-geometry-broken-pieces original))))
     (reverse xml-bend-originals)))
\layout {
  \context { \Voice \consists #xml-bend-engraver }
  \context { \CueVoice \consists #xml-bend-engraver }
  \context { \DrumVoice \consists #xml-bend-engraver }
  \context { \TabVoice \consists #xml-bend-engraver }
  \context { \Staff \consists #xml-bend-engraver }
  \context { \TabStaff \consists #xml-bend-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state bends layout
 (xml-bend-originals xml-bend-count)
 (reset (xml-reset-bends!))
 (clear (xml-clear-bends!)))
