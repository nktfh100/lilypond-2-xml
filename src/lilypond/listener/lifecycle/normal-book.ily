% A source score owns its collector snapshot and final layout throughout book processing.
#(use-modules (srfi srfi-9))
#(define-record-type <xml-normal-score-record>
 (make-xml-normal-score-record index source music initial-state final-state root-system finished? collector-context failure layout book-number part-number)
 xml-normal-score-record?
 (index xml-normal-index xml-normal-index-set!)
 (source xml-normal-source xml-normal-source-set!)
 (music xml-normal-music xml-normal-music-set!)
 (initial-state xml-normal-initial-state xml-normal-initial-state-set!)
 (final-state xml-normal-final-state xml-normal-final-state-set!)
 (root-system xml-normal-root-system xml-normal-root-system-set!)
 (finished? xml-normal-finished? xml-normal-finished?-set!)
 (collector-context xml-normal-collector-context xml-normal-collector-context-set!)
 (failure xml-normal-failure xml-normal-failure-set!)
 (layout xml-normal-layout xml-normal-layout-set!)
 (book-number xml-normal-book-number xml-normal-book-number-set!)
 (part-number xml-normal-part-number xml-normal-part-number-set!)
)
#(define xml-normal-records '())
#(define xml-normal-active #f)
#(define xml-normal-next 0)
#(define xml-normal-enabled #f)
#(define xml-normal-embedded #f)
#(define xml-normal-user-failure #f)
#(define xml-normal-write-pages #t)
#(define xml-normal-page-breaking-fallback #f)
#(define xml-normal-source-layout 'null)
#(define xml-page-layouts '())
#(define xml-page-credits '())
#(define xml-normal-next-book 0)
#(define (xml-normal-save!)
 (when xml-normal-active
  (xml-finish-figure-columns!)
  (xml-normal-final-state-set! xml-normal-active (xml-save-score-state))
  (xml-normal-root-system-set! xml-normal-active
   (ly:context-property (xml-normal-collector-context xml-normal-active) 'rootSystem #f))
  (set! xml-normal-active #f)))
#(define (xml-normal-start-score! ctx)
 (when (and xml-normal-enabled (not xml-normal-embedded))
  (xml-normal-save!)
  (let ((record (ly:output-def-lookup (ly:context-output-def ctx) 'xml-normal-token #f)))
   (unless (and (xml-normal-score-record? record) (memq record xml-normal-records))
    (throw 'xml-normal-missing-collector "No owning score record for the collector."))
   (when (and (xml-normal-collector-context record) (not (eq? (xml-normal-collector-context record) ctx)))
    (throw 'xml-normal-missing-collector "A source score has multiple actual collector contexts."))
   (xml-restore-score-state! (xml-normal-initial-state record))
   (xml-normal-collector-context-set! record ctx)
   (set! xml-normal-active record))))
#(define (xml-normal-capacity-engraver ctx)
 (let ((record (and xml-normal-enabled (not xml-normal-embedded)
   (ly:output-def-lookup (ly:context-output-def ctx) 'xml-normal-token #f))))
  (cons '(must-be-last . #t)
   (make-engraver
    ((initialize engraver)
     (when (and xml-normal-enabled (not xml-normal-embedded))
      (unless (and (xml-normal-score-record? record) (eq? (xml-normal-collector-context record) ctx))
       (throw 'xml-normal-missing-collector "The source Score removed its event collector."))))
    (acknowledgers
     ((grob-interface engraver grob source)
      (when record
       (let ((after (ly:grob-property-data grob 'after-line-breaking)))
        (when (procedure? after)
         (let ((guard (lambda (actual)
           (catch #t (lambda () (after actual))
            (lambda (key . args)
             (xml-normal-failure-set! record (format #f "Normal score after-line callback failed: ~a ~s" key args))
             #f)))))
          (set-procedure-property! guard 'xml-normal-original-after after)
          (ly:grob-set-property! grob 'after-line-breaking guard)))))))
    ((finalize engraver)
     (when (and xml-normal-enabled (not xml-normal-embedded))
      (let ((failure (xml-final-native-capacity-failure)))
       (when failure (throw 'xml-normal-native-capacity failure)))))))))
\layout { \context { \Score \consists #xml-normal-capacity-engraver } }
#(let* ((module (resolve-module '(lily)))
        (original (module-ref module 'ly:score-embedded-format)))
 (module-set! module 'ly:score-embedded-format
  (lambda args
   (if (not xml-normal-enabled) (apply original args)
    (let ((state (xml-save-score-state))
          (active xml-normal-active)
          (embedded xml-normal-embedded))
     (dynamic-wind
      (lambda ()
       (set! xml-normal-active #f)
       (set! xml-normal-embedded #t)
       (xml-reset-semantic-state!)
       (xml-reset-final-layout!)
       (xml-reset-staff-lines!)
       (set! xml-figure-columns '())
       (set! xml-figure-column-systems (make-hash-table)))
      (lambda () (apply original args))
      (lambda ()
       (xml-restore-score-state! state)
       (set! xml-normal-active active)
       (set! xml-normal-embedded embedded))))))))
#(define (xml-normal-source-call callback . args)
 (catch #t (lambda () (apply callback args))
  (lambda (key . args)
   (set! xml-normal-user-failure #t) (apply throw key args))))
#(define (xml-normal-paper-value papers key)
 (let lookup ((sources (append papers (list (ly:parser-lookup '$defaultpaper)))))
  (and (pair? sources)
   (let ((var (module-local-variable (ly:output-def-scope (car sources)) key)))
    (if (and var (variable-bound? var)) (variable-ref var) (lookup (cdr sources)))))))
#(define (xml-normal-score score headers papers first? book-number part-number)
 (set! ed-score-index xml-normal-next)
 (xml-reset-semantic-state!) (xml-reset-final-layout!) (xml-reset-staff-lines!)
 (set! xml-page-layouts '())
 (set! xml-page-credits '())
 (set! xml-figure-columns '()) (set! xml-figure-positions '()) (set! xml-figure-column-systems (make-hash-table))
 (set! ed-book-headers headers) (set! ed-book-papers papers)
 (set! xml-header-book-start first?)
 (set! ed-header (apply ed-header-alist
  (append (list (ly:score-header score)) headers (list (ly:parser-lookup '$defaultheader)))))
 (xml-capture-page-headers) (xml-capture-header-fonts)
 (let* ((definitions (ly:score-output-defs score))
        (printed? (or (null? definitions) (any (lambda (d)
          (eq? (ly:output-def-lookup d 'output-def-kind) 'layout)) definitions)))
        (music (ly:music-deep-copy (ly:score-music score)))
        (layout (ly:output-def-clone
          (or (find (lambda (d) (eq? (ly:output-def-lookup d 'output-def-kind) 'layout))
                    (ly:score-output-defs score)) (ly:parser-lookup '$defaultlayout)))))
  (set! ed-paper (xml-paper-settings layout score))
  (set! xml-normal-source-layout (if printed? #t #f))
  (xml-prepare-cues music)
  (let* ((record (make-xml-normal-score-record ed-score-index score music (xml-save-score-state) #f #f #f #f #f layout book-number part-number))
         (clone (ly:make-score music)))
   (when (module? (ly:score-header score)) (ly:score-set-header! clone (ly:score-header score)))
   (ly:output-def-set-variable! layout 'xml-normal-token record)
   (ly:score-add-output-def! clone layout)
   (set! xml-normal-records (append xml-normal-records (list record))) clone)))
#(define (xml-normal-finish! record failure)
 (xml-restore-score-state! (or (xml-normal-final-state record) (xml-normal-initial-state record)))
 (when (or failure (xml-normal-failure record))
  (set! xml-final-layout-failure (or failure (xml-normal-failure record))))
 (unless xml-final-layout-failure (xml-finish-figure-columns!) (xml-finish-staff-lines! #t))
 (xml-finish-final-layout! #f #t)
 (xml-normal-final-state-set! record (xml-save-score-state))
 (xml-normal-finished?-set! record #t))
#(define (xml-normal-pages paper pages scope)
 (xml-normal-save!)
 (let ((roots (filter-map (lambda (line)
  (let ((system (ly:prob-property line 'system-grob #f)))
   (and (ly:grob? system) (or (ly:grob-original system) system))))
  (append-map (lambda (page) (ly:prob-property page 'lines '())) pages))))
  (for-each (lambda (record)
   (when (and (xml-normal-final-state record) (not (xml-normal-finished? record)) (memq (xml-normal-root-system record) roots))
    (xml-restore-score-state! (xml-normal-final-state record))
    (set! xml-page-layouts (xml-capture-page-layout paper pages (xml-normal-root-system record)
      (xml-normal-book-number record) (xml-normal-part-number record) scope))
    (set! xml-page-credits (xml-capture-page-credits paper pages (xml-normal-root-system record)
      (xml-normal-book-number record) (xml-normal-part-number record) scope))
    (xml-normal-final-state-set! record (xml-save-score-state))
    (xml-normal-finish! record #f))) xml-normal-records)))
#(define (xml-normal-scope scopes pages)
 (let ((owner (and (pair? pages) (ly:prob-property (car pages) 'paper-book #f))))
  (if (not (ly:paper-book? owner)) 0
   (or (hashq-ref (vector-ref scopes 2) owner #f)
    (begin
     (vector-set! scopes 1 (+ 1 (vector-ref scopes 1)))
     (hashq-set! (vector-ref scopes 2) owner (vector-ref scopes 1))
     (vector-ref scopes 1))))))
#(define (xml-normal-book book headers papers part? book-number part-number scopes)
 (let* ((headers (cons (ly:book-header book) headers))
        (own-paper (ly:book-paper book))
        (papers (if (ly:output-def? own-paper) (cons own-paper papers) papers))
        (paper (and (or (not part?) (ly:output-def? own-paper))
          (ly:output-def-clone (if (ly:output-def? own-paper) own-paper (ly:parser-lookup '$defaultpaper)))))
        (post (xml-normal-paper-value papers 'page-post-process))
        (breaker (xml-normal-paper-value papers 'page-breaking))
        (clone (if paper (ly:make-book paper (ly:book-header book)) (ly:make-book-part '())))
        (first? #t))
  (when (module? (ly:book-header book)) (ly:book-set-header! clone (ly:book-header book)))
  (when paper
   (ly:output-def-set-variable! paper 'page-breaking
    (lambda (paper-book)
     (xml-normal-save!)
     (if xml-normal-page-breaking-fallback
      (ly:minimal-breaking paper-book)
      (xml-normal-source-call breaker paper-book))))
   (ly:output-def-set-variable! paper 'page-post-process
    (lambda (actual pages)
     (when (procedure? post) (xml-normal-source-call post actual pages))
     (xml-normal-pages actual pages (xml-normal-scope scopes pages)))))
  (for-each (lambda (entry)
   (if (and (ly:score? entry) (ly:music? (ly:score-music entry)))
    (begin
     (set! xml-normal-next (+ xml-normal-next 1))
     (let ((prepared (and (or (null? (ly:score-output-defs entry))
       (any (lambda (definition) (eq? (ly:output-def-lookup definition 'output-def-kind) 'layout)) (ly:score-output-defs entry)))
       (xml-normal-score entry headers papers first? book-number part-number))))
     (when prepared
      (ly:book-add-score! clone prepared)
      (unless (equal? (ly:music-length (ly:score-music entry)) (ly:make-moment 0)) (set! first? #f)))))
    (ly:book-add-score! clone entry))) (reverse (ly:book-scores book)))
  (for-each (lambda (part)
   (vector-set! scopes 0 (+ 1 (vector-ref scopes 0)))
   (ly:book-add-bookpart! clone (xml-normal-book part headers papers #t book-number (vector-ref scopes 0) scopes)))
   (reverse (ly:book-book-parts book))) clone))
#(define (xml-normal-handler book)
 (when xml-normal-enabled
  (error "Reentrant book processing from a source layout callback is unsupported."))
 (set! xml-normal-records '()) (set! xml-normal-active #f)
 (set! xml-normal-user-failure #f)
 (let* ((failure #f) (capacity? #f) (print-pages (ly:get-option 'print-pages))
        (book-number (begin (set! xml-normal-next-book (+ 1 xml-normal-next-book)) xml-normal-next-book))
        (scopes (vector 0 0 (make-hash-table)))
        (clone (xml-normal-book book '() '() #f book-number 0 scopes)))
  (dynamic-wind
   (lambda ()
    (set! xml-normal-enabled #t)
    (unless xml-normal-write-pages (ly:set-option 'print-pages #f)))
   (lambda ()
    (catch #t (lambda () (print-book-with-defaults clone))
     (lambda (key . args)
      (when (or xml-normal-user-failure (eq? key 'xml-normal-missing-collector)) (apply throw key args))
      (set! capacity? (eq? key 'xml-normal-native-capacity))
      (set! failure (format #f "Normal book layout failed: ~a ~s" key args))))
    (xml-normal-save!)
    (for-each (lambda (record)
     (when (and (not (xml-normal-finished? record)) (or (not capacity?) (xml-normal-final-state record)))
      (cond
       ((xml-normal-final-state record)
        (xml-normal-finish! record (or failure
         "The normal book contains no printed System for this score; final geometry is unavailable.")))
       ((not (equal? (ly:music-length (xml-normal-music record)) (ly:make-moment 0)))
        (error "Normal book did not translate a supported source Score; no collector data is available."))))) xml-normal-records)
    (for-each (lambda (record)
     (xml-restore-score-state! (xml-normal-final-state record))
     (xml-apply-cue-notation!) (ed-write-json!)) (filter (lambda (record) (xml-normal-finished? record)) xml-normal-records)))
   (lambda ()
    (set! xml-normal-enabled #f)
    (unless xml-normal-write-pages (ly:set-option 'print-pages print-pages))
    (set! xml-normal-active #f) (set! xml-normal-records '())))))
#(set! toplevel-book-handler xml-normal-handler)
#(set! default-toplevel-book-handler xml-normal-handler)

% Score lifecycle owned by this collector.
#(xml-define-collector-state normal-book metadata
 (xml-normal-source-layout xml-page-layouts xml-page-credits)
 (reset )
 (clear ))
