#(define (xml-walk-music music procedure)
   (let ((seen (make-hash-table)))
     (let walk ((item music))
       (when (and (ly:music? item) (not (hashq-ref seen item #f)))
         (hashq-set! seen item #t)
         (procedure item)
         (walk (ly:music-property item 'element #f))
         (for-each walk (ly:music-property item 'elements '()))
         (for-each walk (ly:music-property item 'articulations '()))))))
#(define xml-cue-quotes #f)
#(define (xml-prepare-cues music)
   (let ((id 0))
     (set! xml-cue-quotes #f)
     (xml-walk-music music
      (lambda (item)
        (when (and (eq? (ly:music-property item 'name) 'QuoteMusic)
                   (equal? (ly:music-property item 'quoted-context-id) "cue"))
          (set! xml-cue-quotes #t)
          (let ((events (ly:music-property item 'quoted-events)))
            (when (vector? events)
              (set! (ly:music-property item 'quoted-events)
                (list->vector
                 (map
                  (lambda (entry)
                    (cons (car entry)
                      (map
                       (lambda (pair)
                         (let ((event (ly:event-deep-copy (car pair))))
                           (when (memq 'note-event (ly:event-property event 'class))
                             (set! id (+ id 1))
                             (ly:event-set-property! event 'xml-cue-id id))
                           (cons event (cdr pair))))
                       (cdr entry))))
                  (vector->list events)))))))
        #f))))
#(define (xml-run-score music layout score)
   (xml-reset-final-layout!)
   (xml-reset-staff-lines!)
   (set! xml-figure-columns '())
   (set! xml-figure-positions '())
   (set! xml-figure-column-systems (make-hash-table))
   (xml-prepare-cues music)
   (let ((global (ly:run-translator music (xml-final-layout-definition layout score))))
     (xml-finish-figure-columns!)
     (xml-finish-staff-lines!)
     (xml-finish-final-layout! global))
   (xml-apply-cue-notation!)
   (ed-write-json!))

#(define (xml-apply-cue-notation!)
   (set! ed-events
     (map (lambda (event)
       (if (and (assoc-get 'xml-cue-id event #f) (eq? (assoc-get 'k event) 'note))
         (append event '((quoted-cue . #t) (cue . #t))) event)) ed-events)))

% Score lifecycle owned by this collector.
#(xml-define-collector-state quotes metadata
 (xml-cue-quotes)
 (reset )
 (clear ))
