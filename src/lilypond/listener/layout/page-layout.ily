% Read the actual normal book's printed page graph; never initiate formatting.
% All dimensions here are normalized source page units, not local staff spaces.
#(define (xml-capture-page-layout paper pages root book bookpart scope)
   (define (number-or-null value) (if (and (real? value) (finite? value)) value 'null))
   (define (number?* value) (and (real? value) (finite? value)))
   (define (add-known . values) (if (every number?* values) (apply + values) 'null))
   (define systems (if (ly:grob? root) (xml-geometry-broken-pieces root) '()))
   (define originals (reverse xml-staff-line-grobs))
   (define owners-by-original (make-hash-table))
   (define piece-indices (make-hash-table))
   (define indexed-originals
     (let ((id 0))
       (for-each (lambda (entry)
         (set! id (+ id 1))
         (let ((original (car entry)) (piece 0))
           (hashq-set! owners-by-original original
             (cons (cons id entry) (hashq-ref owners-by-original original '())))
           (for-each (lambda (member)
             (set! piece (+ piece 1)) (hashq-set! piece-indices member piece))
             (xml-geometry-broken-pieces original)))) originals)))
   (define (bound-moment grob direction)
     (let* ((bound (ly:spanner-bound grob direction #f))
            (moment (and (ly:grob? bound)
                         (grob::has-interface bound 'paper-column-interface)
                         (ly:grob-property-data bound 'when))))
       (if (ly:moment? moment)
           `((m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))) 'null)))
   (define (known-y-chain? grob system)
     (let loop ((current grob) (seen '()))
       (cond ((eq? current system) #t)
             ((or (not (ly:grob? current)) (memq current seen)) #f)
             (else
              (let ((offset (ly:grob-property-data current 'Y-offset))
                    (parent (ly:grob-parent current Y)))
                ; Pagination can translate an axis group directly, leaving its
                ; immutable standard callback despite an already cached offset.
                ; That callback only reads positioning-done and returns zero.
                (and (or (number?* offset) (null? offset)
                         (and (eq? offset ly:grob::y-parent-positioning)
                              (ly:grob? parent)
                              (eq? (ly:grob-property-data parent 'positioning-done) #t)))
                     (loop parent (cons current seen))))))))
   (define (staff-row grob system system-y)
     (let* ((original (or (ly:grob-original grob) grob))
            (owners (hashq-ref owners-by-original original '()))
            (entry (and (= (length owners) 1) (cdar owners))))
       (and entry
        (let* ((original-id (caar owners))
               (piece (hashq-ref piece-indices grob 0))
               (positions (ly:grob-property-data grob 'line-positions))
               (raw-space (ly:grob-property-data grob 'staff-space))
               (relative-space (if (null? raw-space) 1 raw-space))
               (base-space (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f))
               (space (and (number?* relative-space) (number?* base-space) (* relative-space base-space)))
               (local (and (known-y-chain? grob system)
                           (ly:grob-relative-coordinate grob system Y)))
               (extra (ly:grob-property-data grob 'extra-offset))
               (extra (if (null? extra) '(0 . 0) extra))
               (ink-offset (and space (pair? extra) (number?* (car extra)) (number?* (cdr extra))
                                (vector (* space (car extra)) (- (* space (cdr extra))))))
               (stencil (ly:grob-property-data grob 'stencil))
               (raw-stencil (list-ref entry 3)) (after (list-ref entry 4))
               (custom (or (not (memq raw-stencil (list #f ly:staff-symbol::print)))
                           (not (or (eq? after #f) (null? after)))))
               (hidden (cond ((eq? (ly:grob-property-data grob 'transparent) #t) #t)
                             ((eq? stencil #f) #t)
                             ((ly:stencil? stencil) (ly:stencil-empty? stencil)) (else 'null))))
          `((s . ,(cadr entry))
            (original-id . ,original-id)
            (piece . ,piece)
            (start . ,(bound-moment grob LEFT)) (end . ,(bound-moment grob RIGHT))
            (baseline-y . ,(if (and (number?* system-y) (number?* local))
                               (- system-y local) 'null))
            (ink-offset . ,(or ink-offset 'null))
            (staff-space . ,(number-or-null space))
            (layout-staff-space . ,(number-or-null base-space))
            (line-positions . ,(if (and (list? positions) (every number?* positions))
                                  (list->vector positions) 'null))
            (hidden . ,hidden) (custom . ,(if custom #t #f)) (present . #t))))))
   (let ((page-index 0))
    (append-map
     (lambda (page)
      (set! page-index (+ page-index 1))
      (let* ((actual-book (ly:prob-property page 'paper-book #f))
             (actual-paper (and (ly:paper-book? actual-book) (ly:paper-book-paper actual-book)))
             (owned-scope (if (eq? actual-paper paper) scope 0))
             (displayed (ly:prob-property page 'page-number #f))
             (left (ly:prob-property page 'left-margin #f))
             (right (ly:prob-property page 'right-margin #f))
             (swap? (and actual-paper (ly:output-def-lookup actual-paper 'two-sided #f)
                         (integer? displayed) (odd? displayed)))
             (physical-left (if swap? right left)) (physical-right (if swap? left right))
             (top (ly:prob-property page 'top-margin #f))
             (height (ly:prob-property page 'paper-height #f))
             (bottom-edge (ly:prob-property page 'bottom-edge #f))
             (output-scale (and actual-paper (ly:output-def-lookup actual-paper 'output-scale #f)))
             (horizontal-shift (and actual-paper (ly:output-def-lookup actual-paper 'horizontal-shift 0))))
       (filter-map
        (lambda (line)
         (let* ((system (ly:prob-property line 'system-grob #f))
                (owner (and (ly:grob? system) (or (ly:grob-original system) system)))
                (index (and (eq? owner root) (list-index (lambda (s) (eq? s system)) systems))))
          (and index
           (let* ((extra (ly:prob-property line 'extra-offset '(0 . 0)))
                  (extra-x (and (pair? extra) (car extra))) (extra-y (and (pair? extra) (cdr extra)))
                  (x (add-known physical-left horizontal-shift (ly:prob-property line 'X-offset 0) extra-x))
                  (y (add-known top (ly:prob-property line 'Y-offset #f) extra-y))
                  (array (ly:grob-object system 'all-elements #f))
                  (staves (if (ly:grob-array? array)
                   (filter-map (lambda (grob)
                    (and (grob::has-interface grob 'staff-symbol-interface)
                         (grob::is-live? grob) (eq? (ly:grob-system grob) system)
                         (staff-row grob system y))) (ly:grob-array->list array)) '())))
             `((book . ,book) (bookpart . ,bookpart) (scope . ,owned-scope)
               (page . ,page-index) (displayed-page . ,(number-or-null displayed))
               (system . ,(+ index 1)) (output-scale . ,(number-or-null output-scale))
               (width . ,(number-or-null (ly:prob-property page 'paper-width #f)))
               (height . ,(number-or-null height))
               (top-margin . ,(number-or-null top))
               (bottom-margin . ,(if (and (number?* height) (number?* bottom-edge)) (- height bottom-edge) 'null))
               (left-margin . ,(number-or-null physical-left)) (right-margin . ,(number-or-null physical-right))
               (system-x . ,x) (system-y . ,y) (staves . ,(list->vector staves)))))))
        (ly:prob-property page 'lines '())))) pages)))
