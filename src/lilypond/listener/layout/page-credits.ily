% Inspect the cached page header/footer stencils after normal-book pagination.
% Do not call make-header, make-footer, interpret-markup or source callbacks here.
#(define (xml-page-credit-number value)
   (if (and (real? value) (finite? value)) value 'null))
#(define (xml-page-credit-safe value)
   (cond ((or (eq? value #t) (eq? value #f) (string? value) (number? value)) value)
         ((or (null? value) (eq? value 'null)) 'null)
         ((symbol? value) (symbol->string value))
         ((list? value) (list->vector (map xml-page-credit-safe value)))
         ((pair? value) (vector (xml-page-credit-safe (car value))
                                (xml-page-credit-safe (cdr value))))
         ((vector? value) (list->vector (map xml-page-credit-safe (vector->list value))))
         (else (format #f "~a" value))))
#(define (xml-page-credit-color value)
   (and (pair? value) (every (lambda (n) (and (real? n) (finite? n) (<= 0 n 1))) value)
        (list->vector value)))
#(define (xml-page-credit-walk expr x y positioned? color unsupported state)
   (cond
    ((and (pair? expr) (eq? (car expr) 'utf-8-string)
          (>= (length expr) 3) (string? (caddr expr)))
     (let ((piece (+ 1 (vector-ref state 0))))
      (vector-set! state 0 piece)
      (vector-set! state 1
       (cons `((piece . ,piece) (text . ,(caddr expr))
               (font-description . ,(if (string? (cadr expr)) (cadr expr) 'null))
               (x . ,(if positioned? (xml-page-credit-number x) 'null))
               (y . ,(if positioned? (xml-page-credit-number (- y)) 'null))
               (font-scale . null) (color . ,(or color 'null))
               (unsupported . ,(list->vector (reverse unsupported))))
             (vector-ref state 1)))))
    ((and (pair? expr) (eq? (car expr) 'translate-stencil)
          (>= (length expr) 3) (pair? (cadr expr))
          (real? (caar (cdr expr))) (real? (cdadr expr)))
     (xml-page-credit-walk (caddr expr)
       (+ x (caar (cdr expr))) (+ y (cdadr expr)) positioned? color unsupported state))
    ((and (pair? expr) (eq? (car expr) 'combine-stencil))
     (for-each (lambda (child)
       (xml-page-credit-walk child x y positioned? color unsupported state)) (cdr expr)))
    ((and (pair? expr) (eq? (car expr) 'color-stencil)
          (>= (length expr) 3))
     (let ((rgba (xml-page-credit-color (cadr expr))))
      (xml-page-credit-walk (caddr expr) x y positioned? (or rgba color)
       (if rgba unsupported (cons "unresolved-color-wrapper" unsupported)) state)))
    ((pair? expr)
     (let ((tag (car expr)))
      (vector-set! state 2
       (cons `((command . ,(if (symbol? tag) (symbol->string tag) "expression"))
               (reason . "unsupported cached page stencil expression")
               (data . ,(xml-page-credit-safe expr))) (vector-ref state 2)))
      ;; Keep text from opaque compositions, but quarantine its geometry.
      (when (list? (cdr expr))
       (for-each (lambda (child)
        (xml-page-credit-walk child x y #f color
          (cons "unsupported-stencil-wrapper" unsupported) state)) (cdr expr)))))
    ((or (number? expr) (string? expr) (symbol? expr))
     (vector-set! state 2
      (cons `((command . "primitive") (reason . "opaque cached page stencil leaf")
              (data . ,(xml-page-credit-safe expr))) (vector-ref state 2))))
    (else #f)))
#(define (xml-capture-page-credit-region page region layout book bookpart scope page-index)
   (let* ((key (if (eq? region 'header) 'head-stencil 'foot-stencil))
          (stencil (ly:prob-property page key #f))
          (actual (ly:prob-property page 'paper-book #f))
          (actual-paper (and (ly:paper-book? actual) (ly:paper-book-paper actual)))
          (owned-scope (if (eq? actual-paper layout) scope 0))
          (displayed (ly:prob-property page 'page-number #f))
          (left (ly:prob-property page 'left-margin #f))
          (right (ly:prob-property page 'right-margin #f))
          (two-sided (and actual-paper (ly:output-def-lookup actual-paper 'two-sided #f)))
          (page-x (if two-sided (if (and (integer? displayed) (odd? displayed)) right left) left))
          (horizontal (and actual-paper (ly:output-def-lookup actual-paper 'horizontal-shift 0)))
          (top (ly:prob-property page 'top-margin #f))
          (height (ly:prob-property page 'paper-height #f))
          (bottom-edge (ly:prob-property page 'bottom-edge #f))
          (output-scale (and actual-paper (ly:output-def-lookup actual-paper 'output-scale #f)))
          (y-extent (and (ly:stencil? stencil) (ly:stencil-extent stencil Y)))
          (x0 (and (real? page-x) (real? horizontal) (+ page-x horizontal)))
          (y0 (and y-extent
            (if (eq? region 'header)
              (and (real? top) (- 0 (cdr y-extent) top))
              (and (real? bottom-edge) (- 0 bottom-edge (car y-extent))))))
          (state (vector 0 '() '())))
    (when (ly:stencil? stencil)
      (xml-page-credit-walk (ly:stencil-expr stencil) (or x0 0) (or y0 0)
        (and (real? x0) (real? y0)) #f '() state))
    `((book . ,book) (bookpart . ,bookpart) (scope . ,owned-scope) (page . ,page-index)
      (displayed-page . ,(xml-page-credit-number displayed))
      (region . ,region) (resolved . ,(if (ly:stencil? stencil) #t #f))
      (output-scale . ,(xml-page-credit-number output-scale))
      (width . ,(xml-page-credit-number (ly:prob-property page 'paper-width #f)))
      (height . ,(xml-page-credit-number height))
      (items . ,(list->vector (reverse (vector-ref state 1))))
      (primitives . ,(list->vector (reverse (vector-ref state 2)))))))
#(define (xml-capture-page-credits paper pages root book bookpart scope)
   (let ((page-index 0))
    (append-map
     (lambda (page)
      (set! page-index (+ page-index 1))
      (let* ((lines (ly:prob-property page 'lines '()))
             (owned? (any (lambda (line)
               (let ((system (ly:prob-property line 'system-grob #f)))
                (and (ly:grob? system)
                     (eq? (or (ly:grob-original system) system) root)))) lines)))
       (if owned?
        (list (xml-capture-page-credit-region page 'header paper book bookpart scope page-index)
              (xml-capture-page-credit-region page 'footer paper book bookpart scope page-index))
        '()))) pages)))
