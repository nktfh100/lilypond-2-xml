% Retain actual heads until the source-equivalent completed System stencils exist.
#(define xml-note-position-originals '())
#(define xml-note-position-count 0)
#(define xml-note-position-measures '())
#(define (xml-clear-note-positions!)
 (set! xml-note-position-originals '()) (set! xml-note-position-measures '()))
#(define (xml-reset-note-positions!)
   (xml-clear-note-positions!) (set! xml-note-position-count 0))
#(define (xml-note-position-engraver ctx)
   (make-engraver
    (acknowledgers
     ((note-head-interface engraver grob source)
      (when (eq? ctx (ly:translator-context source))
       (let* ((cause (ly:grob-property grob 'cause #f))
              (name (assoc-get 'name (ly:grob-property grob 'meta)))
              (defaults (assoc-get name all-grob-descriptions))
              (raw-x (ly:grob-property-data grob 'X-offset))
              (raw-y (ly:grob-property-data grob 'Y-offset)))
        (set! xml-note-position-count (+ 1 xml-note-position-count))
        (xml-geometry-observe-root! ctx)
        (set! xml-note-position-originals
         (cons (list grob xml-note-position-count
           (and (ly:stream-event? cause) (ly:event-property cause 'ed-note-id #f))
           (ed-context-id ctx) (ly:context-current-moment ctx) name
           (xml-bracket-stencil grob) (ly:grob-property-data grob 'after-line-breaking)
           (or (not (eq? raw-x (assoc-get 'X-offset defaults)))
               (not (eq? raw-y (assoc-get 'Y-offset defaults)))
               (let ((extra (ly:grob-property-data grob 'extra-offset)))
                (not (or (null? extra) (eq? extra #f)
                  (and (pair? extra) (number? (car extra)) (number? (cdr extra))
                    (= (car extra) 0) (= (cdr extra) 0)))))))
          xml-note-position-originals))))))
    ((stop-translation-timestep engraver)
     (let* ((owner (xml-script-staff ctx))
            (position (ly:context-property owner 'measurePosition #f))
            (column (ly:context-property owner 'currentCommandColumn #f))
            (staff (ed-context-id owner))
            (observed (ly:context-current-moment ctx))
            (canonical (ly:make-moment (ly:moment-main observed))))
      (when (and (ly:moment? position) (= (ly:moment-main position) 0) (ly:grob? column))
       (unless (find (lambda (row) (and (= staff (caddr row)) (equal? canonical (cadr row)))) xml-note-position-measures)
        (set! xml-note-position-measures (cons (list column canonical staff observed) xml-note-position-measures))))))))
#(define (xml-note-position-origin system moment owner)
 (and (ly:grob? system) (ly:moment? moment)
  (let* ((array (ly:grob-object system 'columns #f))
         (columns (if (ly:grob-array? array) (ly:grob-array->list array) '()))
         (left (ly:spanner-bound system LEFT #f))
         (matches (filter-map (lambda (entry)
          (and (= owner (caddr entry)) (<= (ly:moment-main (cadr entry)) (ly:moment-main moment))
           (let ((column (car entry)))
            (cond ((memq column columns) (cons column (cadr entry)))
             ((and (ly:grob? left) (or (eq? left column) (eq? (ly:grob-original left) column)))
              (cons left (cadr entry)))
             (else #f))))) xml-note-position-measures)))
   (and (pair? matches) (car (sort matches (lambda (a b) (not (moment<=? (cdr a) (cdr b))))))))))
#(define (xml-final-note-positions)
   (let* ((systems (if (ly:grob? xml-geometry-root-system) (xml-geometry-broken-pieces xml-geometry-root-system) '()))
          (by-original (make-hash-table)))
    (for-each (lambda (system)
      (let ((array (ly:grob-object system 'all-elements)))
       (when (ly:grob-array? array)
        (for-each (lambda (grob)
         (when (and (eq? (ly:grob-system grob) system) (grob::has-interface grob 'note-head-interface))
          (let ((original (or (ly:grob-original grob) grob)))
           (hashq-set! by-original original (cons grob (hashq-ref by-original original '()))))))
         (ly:grob-array->list array))))) systems)
    (append-map
     (lambda (entry)
      (let* ((original (car entry)) (piece 0)
             (items (delete-duplicates (reverse (hashq-ref by-original original '())))))
       (map (lambda (grob)
        (set! piece (+ piece 1))
        (let* ((system (ly:grob-system grob))
               (column (ly:item-get-column grob))
               (column-moment (and (ly:grob? column) (ly:grob-property-data column 'when)))
               (moment (if (ly:moment? column-moment) column-moment (list-ref entry 4)))
               (staff-object (ly:grob-object grob 'staff-symbol #f))
               (staff-pieces (if (ly:grob? staff-object) (filter (lambda (s) (eq? (ly:grob-system s) system)) (xml-geometry-broken-pieces staff-object)) '()))
               (staff (and (= (length staff-pieces) 1) (car staff-pieces)))
               (owners (if (ly:grob? staff) (filter (lambda (row)
                (or (eq? (cdr row) staff) (eq? (cdr row) (ly:grob-original staff)))) xml-geometry-staff-symbols) '()))
               (owner (and (= (length owners) 1) (caar owners)))
               (positions (and (ly:grob? staff) (ly:grob-property staff 'line-positions '())))
               (top (and (pair? positions) (every number? positions)
                 (+ (ly:grob-relative-coordinate staff system Y) (xml-geometry-render-extra staff Y)
                  (* .5 (ly:staff-symbol-staff-space staff) (apply max positions)))))
               (stencil (ly:grob-property-data grob 'stencil))
               (live (and (grob::is-live? grob) (ly:stencil? stencil) (not (ly:stencil-empty? stencil))))
               (raw (list-ref entry 6)) (after (list-ref entry 7))
               (custom (or (not (memq raw (list #f ly:note-head::print)))
                 (not (or (eq? after #f) (null? after)))))
               (space (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f))
               (scale (and (number? space) (> space 0) (/ 10 space)))
               (origin (and owner (xml-note-position-origin system moment owner)))
               (x (and origin scale live (* scale
                (- (+ (ly:grob-relative-coordinate grob system X) (xml-geometry-render-extra grob X))
                   (ly:grob-relative-coordinate (car origin) system X)))))
               (left (and x (ly:stencil-extent stencil X)))
               (glyph-left (and left (pair? left) (+ x (* scale (car left)))))
               (y (and top scale live (* scale
                (- (+ (ly:grob-relative-coordinate grob system Y) (xml-geometry-render-extra grob Y)) top)))))
         `((k . note-position) (id . ,(cadr entry)) (piece . ,piece)
           (nid . ,(or (list-ref entry 2) 'null)) (voice . ,(list-ref entry 3)) (s . ,(or owner 'null))
           (m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
           (column-m . ,(if (ly:moment? column-moment) (ly:moment-main column-moment) 'null))
           (column-g . ,(if (ly:moment? column-moment) (ly:moment-grace column-moment) 'null))
           (x-tenths . ,(or glyph-left 'null)) (y-tenths . ,(or y 'null))
           (origin-x-tenths . ,(or x 'null)) (glyph-left-x-tenths . ,(or glyph-left 'null))
           (x-ref-m . ,(if origin (ly:moment-main (cdr origin)) 'null))
           (x-ref-g . ,(if origin (ly:moment-grace (cdr origin)) 'null))
           (staff-space . ,(ly:staff-symbol-staff-space grob)) (layout-staff-space . ,(or space 'null))
           (hidden . ,(or (eq? raw #f) (not live) (eq? (ly:grob-property grob 'transparent #f) #t)))
           (custom . ,(if custom #t #f)) (head-only-offset . ,(if (list-ref entry 8) #t #f))
           (grob-name . ,(list-ref entry 5))))) items)))
     (reverse xml-note-position-originals))))
\layout {
 \context { \Voice \consists #xml-note-position-engraver }
 \context { \CueVoice \consists #xml-note-position-engraver }
 \context { \DrumVoice \consists #xml-note-position-engraver }
 \context { \TabVoice \consists #xml-note-position-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state note-positions layout
 (xml-note-position-originals xml-note-position-count xml-note-position-measures)
 (reset (xml-reset-note-positions!))
 (clear (xml-clear-note-positions!)))
