% Measure boxes come from actual command columns in completed source systems.
#(define xml-measure-layout-originals '())
#(define (xml-clear-measure-layout!) (set! xml-measure-layout-originals '()))
#(define (xml-reset-measure-layout!) (xml-clear-measure-layout!))
#(define (xml-measure-layout-engraver ctx)
 (let ((record (vector (ed-context-id ctx) '() #f)))
  (make-engraver
   ((initialize engraver)
    (set! xml-measure-layout-originals (cons record xml-measure-layout-originals)))
   ((stop-translation-timestep engraver)
    (let* ((column (ly:context-property ctx 'currentCommandColumn #f))
           (moment (ly:context-current-moment ctx))
           (position (ly:context-property ctx 'measurePosition #f))
           (canonical (ly:make-moment (ly:moment-main moment)))
           (rows (vector-ref record 1)))
     (xml-geometry-observe-root! ctx)
     (when (ly:grob? column)
      (vector-set! record 2 (list column canonical 'terminal))
      (when (or (null? rows) (and (ly:moment? position) (= (ly:moment-main position) 0)))
       (unless (find (lambda (r) (equal? (cadr r) canonical)) rows)
        (vector-set! record 1 (cons (list column canonical 'measure) rows))))))))))
#(define (xml-measure-layout-column original system)
 (let ((left (ly:spanner-bound system LEFT #f)) (right (ly:spanner-bound system RIGHT #f)))
  (cond ((eq? (ly:grob-system original) system) original)
   ((and (ly:grob? left) (or (eq? original left) (eq? original (ly:grob-original left)))) left)
   ((and (ly:grob? right) (or (eq? original right) (eq? original (ly:grob-original right)))) right)
   (else #f))))
#(define (xml-final-measure-layout)
 (let ((systems (if (ly:grob? xml-geometry-root-system) (xml-geometry-broken-pieces xml-geometry-root-system) '()))
       (next-id 0))
  (append-map (lambda (record)
   (let* ((staff (vector-ref record 0)) (rows (reverse (vector-ref record 1)))
          (terminal (vector-ref record 2)) (system-index 0)
          (all (if (and terminal (not (any (lambda (r) (equal? (cadr r) (cadr terminal))) rows))) (append rows (list terminal)) rows)))
    (append-map (lambda (system)
     (set! system-index (+ 1 system-index))
     (let* ((left (ly:spanner-bound system LEFT #f)) (right (ly:spanner-bound system RIGHT #f))
            (space (ly:output-def-lookup (ly:grob-layout system) 'staff-space #f))
            (scale (and (number? space) (> space 0) (/ 10 space)))
            (line-width (ly:output-def-lookup (ly:grob-layout system) 'line-width #f))
            (actual (filter-map (lambda (r)
             (let ((column (xml-measure-layout-column (car r) system)))
              (and column (list column (cadr r) (caddr r))))) all)))
      (for-each (lambda (bound)
       (when (and (ly:grob? bound) (not (any (lambda (r) (eq? (car r) bound)) actual)))
        (let ((column-time (ly:grob-property-data bound 'when)))
         (when (ly:moment? column-time)
          (set! actual (cons (list bound (ly:make-moment (ly:moment-main column-time)) 'system) actual))))))
       (list left right))
      (set! actual (sort actual (lambda (a b)
       (let ((am (ly:grob-property-data (car a) 'when))
             (bm (ly:grob-property-data (car b) 'when)))
        (not (moment<=? (if (ly:moment? bm) bm (cadr b))
                       (if (ly:moment? am) am (cadr a))))))))
      (let loop ((remaining actual) (out '()))
       (if (or (null? remaining) (null? (cdr remaining))) (reverse out)
        (let* ((a (car remaining)) (b (cadr remaining))
               (am (ly:grob-property-data (car a) 'when)) (bm (ly:grob-property-data (car b) 'when))
               (x (and scale (* scale (ly:grob-relative-coordinate (car a) system X))))
               (end-x (and scale (* scale (ly:grob-relative-coordinate (car b) system X)))))
         (set! next-id (+ 1 next-id))
         (loop (cdr remaining)
          (cons `((k . measure-layout) (id . ,next-id) (piece . 1) (s . ,staff)
           (m . ,(ly:moment-main (cadr a))) (g . ,(ly:moment-grace (cadr a)))
           (end-m . ,(ly:moment-main (cadr b))) (end-g . ,(ly:moment-grace (cadr b)))
           (column-m . ,(if (ly:moment? am) (ly:moment-main am) 'null))
           (column-g . ,(if (ly:moment? am) (ly:moment-grace am) 'null))
           (end-column-m . ,(if (ly:moment? bm) (ly:moment-main bm) 'null))
           (end-column-g . ,(if (ly:moment? bm) (ly:moment-grace bm) 'null))
           (system . ,system-index) (start-x-tenths . ,(or x 'null)) (end-x-tenths . ,(or end-x 'null))
           (width-tenths . ,(if (and x end-x) (- end-x x) 'null))
           (layout-staff-space . ,(or space 'null))
           (line-width-tenths . ,(if (and scale (number? line-width)) (* scale line-width) 'null))
           (system-left-x-tenths . ,(if (and scale (ly:grob? left)) (* scale (ly:grob-relative-coordinate left system X)) 'null))
           (system-right-x-tenths . ,(if (and scale (ly:grob? right)) (* scale (ly:grob-relative-coordinate right system X)) 'null))
           (first-on-system . ,(eq? (car a) left)) (last-on-system . ,(eq? (car b) right))
           (start-kind . ,(if (eq? (caddr a) 'measure) 'measure 'system)) (end-kind . ,(caddr b))) out))))))) systems)))
   (reverse xml-measure-layout-originals))))
\layout {
 \context { \Staff \consists #xml-measure-layout-engraver }
 \context { \TabStaff \consists #xml-measure-layout-engraver }
 \context { \DrumStaff \consists #xml-measure-layout-engraver }
 \context { \RhythmicStaff \consists #xml-measure-layout-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state measure-layout layout
 (xml-measure-layout-originals)
 (reset (xml-reset-measure-layout!))
 (clear (xml-clear-measure-layout!)))
