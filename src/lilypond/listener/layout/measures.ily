#(define xml-barline-originals '())
#(define xml-barline-count 0)
#(define (xml-reset-barlines!)
 (set! xml-barline-originals '()) (set! xml-barline-count 0))
#(define (xml-barline-stencil-data grob)
 (let ((value (ly:grob-property-data grob 'stencil)))
  (if (ly:unpure-pure-container? value) (ly:unpure-pure-container-unpure-part value) value)))
#(define (xml-measure-engraver ctx)
 (let ((bars '()))
  (make-engraver
   (acknowledgers
    ((bar-line-interface engraver grob source-engraver)
     (when (eq? ctx (ly:translator-context source-engraver))
      (set! xml-barline-count (+ 1 xml-barline-count))
      (let ((row (list grob xml-barline-count (ed-context-id ctx)
                  (ly:context-current-moment ctx) (xml-barline-stencil-data grob)
                  (ly:grob-property-data grob 'after-line-breaking))))
       (set! bars (cons row bars))
       (set! xml-barline-originals (cons row xml-barline-originals))))))
   ((stop-translation-timestep engraver)
    (for-each (lambda (row)
     (let* ((bar (car row)) (glyph (ly:grob-property-data bar 'glyph-name)))
      (ed-push! ctx `((k . barline) (id . ,(cadr row)) (s . ,(caddr row))
       (glyph . ,(if (string? glyph) glyph ""))
       (hidden . ,(or (eq? (list-ref row 4) #f)
                     (eq? (ly:grob-property-data bar 'transparent) #t))))))) (reverse bars))
    (set! bars '())))))
#(define (xml-final-barlines)
 (let* ((systems (if (ly:grob? xml-geometry-root-system) (xml-geometry-broken-pieces xml-geometry-root-system) '()))
        (by-original (make-hash-table)) (system-index 0))
  (for-each (lambda (system)
   (set! system-index (+ 1 system-index))
   (let ((array (ly:grob-object system 'all-elements #f)))
    (when (ly:grob-array? array)
     (for-each (lambda (grob)
      (when (and (ly:item? grob) (grob::has-interface grob 'bar-line-interface)
                 (eq? (ly:grob-system grob) system) (grob::is-live? grob))
       (let ((original (or (ly:grob-original grob) grob)))
        (hashq-set! by-original original
         (cons (cons grob system-index) (hashq-ref by-original original '()))))))
      (ly:grob-array->list array))))) systems)
  (map (lambda (row)
   (let* ((original (car row)) (moment (list-ref row 3))
          (raw (list-ref row 4)) (after (list-ref row 5))
          (custom (or (not (memq raw (list #f ly:bar-line::print)))
                      (not (or (eq? after #f) (null? after)))))
          (members (reverse (hashq-ref by-original original '())))
          (pieces (filter-map (lambda (member)
           (let* ((grob (car member)) (stencil (ly:grob-property-data grob 'stencil))
                  (glyph (ly:grob-property-data grob 'glyph-name))
                  (transparent (ly:grob-property-data grob 'transparent)))
            (and (not (eq? stencil #f))
             `((system . ,(cdr member)) (break-direction . ,(ly:item-break-dir grob))
               (glyph . ,(if (string? glyph) glyph 'null))
               (hidden . ,(cond ((eq? transparent #t) #t)
                  ((ly:stencil? stencil) (ly:stencil-empty? stencil)) (else 'null)))
               (custom . ,(if custom #t #f)))))) members)))
    `((k . barline-layout) (id . ,(cadr row)) (s . ,(caddr row))
      (m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
      (pieces . ,(list->vector pieces)))))
   (reverse xml-barline-originals))))
\layout {
 \context { \Staff \consists #xml-measure-engraver }
 \context { \TabStaff \consists #xml-measure-engraver }
 \context { \DrumStaff \consists #xml-measure-engraver }
 \context { \RhythmicStaff \consists #xml-measure-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state measures layout
 (xml-barline-originals xml-barline-count)
 (reset (xml-reset-barlines!))
 (clear (xml-reset-barlines!)))
