#(define (xml-color-components value)
   (if (string? value)
       (let ((rgba (normalize-color value)))
         (if (= (list-ref rgba 3) 1) (take rgba 3) rgba)) value))
#(define (xml-color value) (ed-value (xml-color-components value)))
#(define (xml-markup-tree value)
   (cond
    ((and (pair? value) (procedure? (car value)))
     (let ((name (or (procedure-name (car value)) 'custom-markup)))
       `((command . ,name)
         (args . ,(list->vector (map xml-markup-tree
                   (if (eq? name 'with-color-markup)
                       (cons (xml-color-components (cadr value)) (cddr value)) (cdr value)))))
         (plain . ,(ed-markup->string value)))))
    ((list? value) (list->vector (map xml-markup-tree value)))
    ((pair? value) (vector (xml-markup-tree (car value)) (xml-markup-tree (cdr value))))
    ((or (string? value) (symbol? value) (number? value) (boolean? value)) value)
    (else 'null)))
#(define (xml-text-font-context layout props)
   (let* ((reference (ly:output-def-lookup layout 'text-font-size 11))
          (size (chain-assoc-get 'font-size props 0))
          (family (chain-assoc-get 'font-family props 'roman))
          (name (chain-assoc-get 'font-name props #f))
          (series (chain-assoc-get 'font-series props 'medium))
          (shape (chain-assoc-get 'font-shape props 'upright))
          (unsupported (filter-map (lambda (entry) (and (not (memq (cdr entry) (case (car entry)
                            ((font-family) '(roman sans typewriter)) ((font-series) '(medium bold))
                            ((font-shape) '(upright italic))))) (format #f "~a=~a" (car entry) (cdr entry))))
                         (list (cons 'font-family family) (cons 'font-series series) (cons 'font-shape shape)))))
     `((reference . ,reference)
       (attrs . ((font-size . ,(* reference (magstep size)))
                 (font-family . ,(if (string? name) name (case family ((sans) "sans-serif") ((typewriter) "monospace") (else "serif"))))
                 (font-weight . ,(if (eq? series 'bold) "bold" "normal"))
                 (font-style . ,(if (eq? shape 'italic) "italic" "normal"))))
       (unsupported . ,(list->vector unsupported)))))
