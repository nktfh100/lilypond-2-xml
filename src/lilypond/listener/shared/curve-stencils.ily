% Decode the narrow two-cubic ribbon emitted by LilyPond's standard curve
% stencils. The result is a centerline in stencil-local coordinates.
#(define (xml-curve-number? value) (and (real? value) (finite? value)))
#(define (xml-curve-point? value)
   (and (pair? value) (xml-curve-number? (car value)) (xml-curve-number? (cdr value))))
#(define (xml-curve-same-point? left right)
   (and (xml-curve-point? left) (xml-curve-point? right)
        (= (car left) (car right)) (= (cdr left) (cdr right))))
#(define (xml-curve-average-points left right dx dy)
   (cons (+ dx (* .5 (+ (car left) (car right))))
         (+ dy (* .5 (+ (cdr left) (cdr right))))))
#(define (xml-curve-standard-path-centerline expression dx dy)
   (and (list? expression) (= (length expression) 6)
        (eq? (car expression) 'path)
        (xml-curve-number? (cadr expression)) (>= (cadr expression) 0)
        (eq? (list-ref expression 3) 'round) (eq? (list-ref expression 4) 'round)
        (eq? (list-ref expression 5) #t)
     (let ((commands (list-ref expression 2)))
      (and (list? commands) (= (length commands) 21)
           (eq? (list-ref commands 0) 'moveto)
           (eq? (list-ref commands 3) 'curveto)
           (eq? (list-ref commands 10) 'lineto)
           (eq? (list-ref commands 13) 'curveto)
           (eq? (list-ref commands 20) 'closepath)
           (every xml-curve-number? (map (lambda (index) (list-ref commands index))
             '(1 2 4 5 6 7 8 9 11 12 14 15 16 17 18 19)))
       (let* ((p0 (cons (list-ref commands 1) (list-ref commands 2)))
              (p1 (cons (list-ref commands 4) (list-ref commands 5)))
              (p2 (cons (list-ref commands 6) (list-ref commands 7)))
              (p3 (cons (list-ref commands 8) (list-ref commands 9)))
              (line-end (cons (list-ref commands 11) (list-ref commands 12)))
              (q1 (cons (list-ref commands 14) (list-ref commands 15)))
              (q2 (cons (list-ref commands 16) (list-ref commands 17)))
              (q3 (cons (list-ref commands 18) (list-ref commands 19))))
         (and (xml-curve-same-point? p3 line-end) (xml-curve-same-point? p0 q3)
           (list (xml-curve-average-points p0 q3 dx dy)
                 (xml-curve-average-points p1 q2 dx dy)
                 (xml-curve-average-points p2 q1 dx dy)
                 (xml-curve-average-points p3 line-end dx dy))))))))
#(define (xml-curve-stencil-centerline expression depth dx dy)
   (and (<= depth 8)
    (cond
     ((and (list? expression) (= (length expression) 3) (eq? (car expression) 'translate-stencil)
           (pair? (cadr expression)) (xml-curve-number? (caadr expression)) (xml-curve-number? (cdadr expression)))
      (xml-curve-stencil-centerline (caddr expression) (+ depth 1)
        (+ dx (caadr expression)) (+ dy (cdadr expression))))
     ((and (list? expression) (= (length expression) 3) (eq? (car expression) 'color-stencil)
           (list? (cadr expression)) (or (= (length (cadr expression)) 3) (= (length (cadr expression)) 4))
           (every (lambda (value) (and (xml-curve-number? value) (<= 0 value 1))) (cadr expression)))
      (xml-curve-stencil-centerline (caddr expression) (+ depth 1) dx dy))
     ((and (list? expression) (pair? expression) (eq? (car expression) 'path))
      (xml-curve-standard-path-centerline expression dx dy))
     (else #f))))
