% Actual Lyrics-owned extender graphics, including early Lyrics completion.
#(define xml-lyric-extender-originals '())
#(define xml-lyric-extender-syllables '())
#(define xml-lyric-extender-heard '())
#(define xml-lyric-extender-count 0)
#(define (xml-clear-lyric-extenders!)
   (set! xml-lyric-extender-originals '())
   (set! xml-lyric-extender-syllables '())
   (set! xml-lyric-extender-heard '()))
#(define (xml-reset-lyric-extenders!)
   (xml-clear-lyric-extenders!) (set! xml-lyric-extender-count 0))
#(define (xml-lyric-extender-engraver ctx)
   (make-engraver
    (listeners
     ((lyric-event engraver event)
      (set! xml-lyric-extender-heard
       (cons (list event (ed-context-id ctx) (ly:context-current-moment ctx)) xml-lyric-extender-heard))))
    (acknowledgers
     ((lyric-syllable-interface engraver grob source)
      (when (and (eq? ctx (ly:translator-context source))
                 (eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'LyricText))
       (let* ((cause (ly:grob-property grob 'cause #f))
              (heard (filter (lambda (entry) (and (eq? cause (car entry))
                (= (cadr entry) (ed-context-id ctx))
                (equal? (caddr entry) (ly:context-current-moment ctx)))) xml-lyric-extender-heard)))
         (set! xml-lyric-extender-syllables
          (cons (list grob (ed-context-id ctx) (and (pair? heard) (caddr (car heard))))
                xml-lyric-extender-syllables)))))
     ((lyric-extender-interface engraver grob source)
      (when (and (eq? ctx (ly:translator-context source))
                 (eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'LyricExtender))
       (set! xml-lyric-extender-count (+ 1 xml-lyric-extender-count))
       (xml-geometry-observe-root! ctx)
       (let* ((voice (ly:context-property ctx 'associatedVoiceContext #f))
              (staff (and (ly:context? voice) (xml-script-staff voice))))
         (set! xml-lyric-extender-originals
          (cons (list grob xml-lyric-extender-count (ed-context-id ctx)
                      (and (ly:context? voice) (ed-context-id voice))
                      (and (ly:context? staff) (ed-context-id staff))
                      (ly:context-current-moment ctx) (xml-bracket-stencil grob)
                      (ly:grob-property-data grob 'after-line-breaking))
                xml-lyric-extender-originals))))))))
#(define (xml-lyric-extender-note-id head)
   (let ((cause (and (ly:grob? head) (ly:grob-property head 'cause #f))))
     (if (ly:stream-event? cause) (ly:event-property cause 'ed-note-id 'null) 'null)))
#(define (xml-final-lyric-extenders)
   (append-map
    (lambda (entry)
     (let* ((original (car entry)) (original-left (ly:spanner-bound original LEFT #f))
            (syllable (find (lambda (item) (and (= (cadr item) (list-ref entry 2))
              (or (eq? original-left (car item))
                  (and (ly:grob? original-left) (eq? (ly:grob-original original-left) (car item))))))
               xml-lyric-extender-syllables))
            (lyric-moment (and syllable (caddr syllable)))
            (piece 0))
      (map (lambda (grob)
        (set! piece (+ 1 piece))
        (let* ((left (xml-duration-bound (ly:spanner-bound grob LEFT #f)))
               (right-bound (ly:spanner-bound grob RIGHT #f))
               (right (xml-duration-bound right-bound))
               (start (and left (cadr left))) (end (and right (cadr right)))
               (moment (if (ly:moment? start) start (list-ref entry 5)))
               (raw (list-ref entry 6)) (after (list-ref entry 7))
               (stencil (ly:grob-property grob 'stencil #f))
               (live (and (grob::is-live? grob) (ly:stencil? stencil) (not (ly:stencil-empty? stencil))))
               (standard (or (eq? raw #f) (eq? raw ly:lyric-extender::print)))
               (custom (or (not standard) (not (or (eq? after #f) (null? after)))))
               (system (ly:grob-system grob)) (owner (list-ref entry 4))
               ; The standard printer reads this actual piece's heads.  Breaking
               ; can clear the original spanner's support array.
               (array (ly:grob-object grob 'heads #f))
               (heads (if (ly:grob-array? array) (ly:grob-array->list array) '()))
               (boxes (and live standard (not custom)
                 (xml-optional-material-boxes (ly:stencil-expr stencil) 0 0)))
               (space (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f))
               (scale (and (number? space) (> space 0) (/ 10 space)))
               (origin (and owner (xml-line-origin system start owner)))
               (staff (and owner (xml-geometry-unique-staff system owner)))
               (top (xml-geometry-staff-top staff system))
               (x (and origin (- (+ (ly:grob-relative-coordinate grob system X)
                 (xml-geometry-render-extra grob X)) (ly:grob-relative-coordinate (car origin) system X))))
               (y (and top (- (+ (ly:grob-relative-coordinate grob system Y)
                 (xml-geometry-render-extra grob Y)) top))))
          `((k . lyric-extender) (id . ,(cadr entry)) (piece . ,piece) (verse . ,(list-ref entry 2))
            (voice . ,(or (list-ref entry 3) 'null)) (s . ,(or owner 'null))
            (m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
            (end-m . ,(if (ly:moment? end) (ly:moment-main end) 'null))
            (end-g . ,(if (ly:moment? end) (ly:moment-grace end) 'null))
            (lyric-m . ,(if (ly:moment? lyric-moment) (ly:moment-main lyric-moment) 'null))
            (lyric-g . ,(if (ly:moment? lyric-moment) (ly:moment-grace lyric-moment) 'null))
            (left-kind . ,(if left (car left) 'null)) (right-kind . ,(if right (car right) 'null))
            (head-notes . ,(list->vector (map xml-lyric-extender-note-id heads)))
            (to-notes . ,(if (and (ly:grob? right-bound) (grob::has-interface right-bound 'note-head-interface))
              (vector (xml-lyric-extender-note-id right-bound)) #()))
            (auto-generated . ,(eq? (ly:grob-property original 'auto-generated #f) #t))
            (color . ,(xml-color (ly:grob-property grob 'color #f)))
            (hidden . ,(or (eq? raw #f) (not live) (eq? (ly:grob-property grob 'transparent #f) #t)))
            (custom . ,(if custom #t #f))
            (rectangles . ,(if (and boxes scale x y) (list->vector
             (map (lambda (box) (list->vector (list
               (* scale (+ x (list-ref box 0))) (* scale (+ x (list-ref box 1)))
               (* scale (+ y (list-ref box 2))) (* scale (+ y (list-ref box 3)))
               (* scale (list-ref box 4))))) boxes)) 'null))
            (x-ref-m . ,(if origin (ly:moment-main (cdr origin)) 'null))
            (x-ref-g . ,(if origin (ly:moment-grace (cdr origin)) 'null))
            (staff-space . ,(ly:staff-symbol-staff-space grob))
            (layout-staff-space . ,(or space 'null)))))
       (xml-geometry-broken-pieces original))))
    (reverse xml-lyric-extender-originals)))
\layout { \context { \Lyrics \consists #xml-lyric-extender-engraver } }

% Score lifecycle owned by this collector.
#(xml-define-collector-state lyric-extenders layout
 (xml-lyric-extender-originals xml-lyric-extender-syllables xml-lyric-extender-heard xml-lyric-extender-count)
 (reset (xml-reset-lyric-extenders!))
 (clear (xml-clear-lyric-extenders!)))
