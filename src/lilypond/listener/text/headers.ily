#(define xml-header-markup '())
#(define xml-header-scopes '())
#(define xml-header-book-start #t)
#(define (xml-header-paper-value name)
   (let loop ((sources (append ed-book-papers (list (ly:parser-lookup '$defaultpaper)))))
     (and (pair? sources)
          (let ((var (module-local-variable (ly:output-def-scope (car sources)) name)))
            (if (and var (variable-bound? var)) (variable-ref var) (loop (cdr sources)))))))
#(define xml-page-header-markup '())
#(define xml-header-keys
   '(dedication title subtitle subsubtitle instrument composer arranger poet meter piece opus copyright tagline
     source style maintainer license mutopiatitle mutopiacomposer mutopiaopus mutopiainstrument date))
#(define (xml-header-entry key modules)
   (and (pair? modules)
        (let* ((mod (car modules)) (var (and (module? mod) (module-variable mod key))))
          (if (and var (variable-bound? var)) (cons key (variable-ref var))
              (xml-header-entry key (cdr modules))))))
#(define (xml-header-module-keys modules)
   (delete-duplicates (append xml-header-keys
     (append-map (lambda (mod) (if (module? mod) (map car (ly:module->alist mod)) '())) modules))))
#(define (ed-header-alist . modules)
   (let ((entries (filter-map (lambda (key) (xml-header-entry key modules)) (xml-header-module-keys modules))))
     (set! xml-header-markup (map (lambda (entry) (cons (car entry) (xml-markup-tree (cdr entry)))) entries))
     (let* ((book-entries (filter-map (lambda (key) (xml-header-entry key (cdr modules))) (xml-header-module-keys (cdr modules))))
            (book (if (assq 'tagline book-entries) book-entries
                      (acons 'tagline (xml-header-paper-value 'tagline) book-entries))))
       (set! xml-header-scopes
         `((book . ,(map (lambda (entry) (cons (car entry) (xml-markup-tree (cdr entry)))) book))
           (bookStart . ,xml-header-book-start)
           (printAllHeaders . ,(eq? #t (xml-header-paper-value 'print-all-headers))))))
     (map (lambda (entry)
            (cons (car entry) (let ((v (cdr entry)))
                               (cond ((not v) "") ((markup? v) (ed-markup->string v))
                                     ((number? v) (number->string v)) (else ""))))) entries)))
#(define xml-page-header-names '(oddHeaderMarkup evenHeaderMarkup oddFooterMarkup evenFooterMarkup bookTitleMarkup scoreTitleMarkup))
#(define xml-original-page-headers
   (map (lambda (name) (cons name (ly:output-def-lookup (ly:parser-lookup '$defaultpaper) name #f))) xml-page-header-names))
#(define (xml-capture-page-headers)
   (let ((sources (append ed-book-papers (list (ly:parser-lookup '$defaultpaper)))))
     (set! xml-page-header-markup
       (filter-map
        (lambda (name)
          (let ((value (let loop ((remaining sources))
                         (if (null? remaining) #f
                             (let ((var (module-local-variable (ly:output-def-scope (car remaining)) name)))
                               (if (and var (variable-bound? var)) (variable-ref var) (loop (cdr remaining))))))))
            (and (not (equal? value (assoc-get name xml-original-page-headers)))
                 (cons name (xml-markup-tree value)))))
        xml-page-header-names))))
#(define xml-header-styles '())
#(define xml-header-style-base #f)
#(define-markup-command (xml-header-font-field layout props key) (symbol?)
   (let ((name (symbol->string key)))
     (when (string-prefix? "header:" name)
       (set! xml-header-styles (acons (string->symbol (substring name 7)) (xml-text-font-context layout props) xml-header-styles))))
   empty-stencil)
#(define (xml-header-font-tree value)
   (cond ((and (pair? value) (procedure? (car value)))
          (cons (if (eq? (procedure-name (car value)) 'fromproperty-markup) xml-header-font-field-markup (car value))
                (map xml-header-font-tree (cdr value))))
         ((list? value) (map xml-header-font-tree value)) (else value)))
#(define (xml-capture-header-fonts)
   (set! xml-header-styles '())
   (set! xml-header-style-base #f)
   (ed-guard 'header-font-context
     (lambda ()
       (let ((paper (ly:output-def-clone (ly:parser-lookup '$defaultpaper))))
         (for-each (lambda (source)
                     (module-for-each (lambda (name var) (when (variable-bound? var)
                       (ly:output-def-set-variable! paper name (variable-ref var)))) (ly:output-def-scope source)))
                   (reverse ed-book-papers))
         (let ((props (list (append '((line-width . 100) (font-encoding . latin1))
                                   (ly:output-def-lookup paper 'property-defaults)))))
           (set! xml-header-style-base (xml-text-font-context paper props))
           (for-each (lambda (name)
                       (interpret-markup paper props (xml-header-font-tree (assoc-get name xml-original-page-headers))))
                     '(bookTitleMarkup))
           (set! xml-header-styles
             (append xml-header-styles
                     (map (lambda (key) (cons key xml-header-style-base)) '(piece opus copyright)))))))))

% Score lifecycle owned by this collector.
#(xml-define-collector-state headers metadata
 (xml-header-markup xml-header-scopes xml-header-book-start xml-page-header-markup xml-header-styles xml-header-style-base)
 (reset )
 (clear ))
