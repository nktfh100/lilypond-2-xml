% Late, passive capture of plain strings in canonical TextScript column markup.
% The sidecar event refers to the original text-script-event by an ID assigned
% before event-document serializes note attachments.
#(set-object-property! 'xml-text-column-id 'music-type? integer?)
#(set-object-property! 'xml-text-column-id 'music-doc "Stable source ID for a captured TextScript column.")
#(define xml-text-column-next 0)
#(define xml-text-column-stage 'idle)
#(define xml-text-column-originals '())
#(define xml-text-column-cache (make-hash-table))
#(define xml-text-column-staff-symbols '())
#(define (xml-reset-text-columns!)
   (set! xml-text-column-next 0)
   (set! xml-text-column-originals '())
   (set! xml-text-column-cache (make-hash-table))
   (set! xml-text-column-staff-symbols '()))
#(define (xml-clear-text-columns!)
   (set! xml-text-column-originals '())
   (set! xml-text-column-cache (make-hash-table))
   (set! xml-text-column-staff-symbols '()))
#(define (xml-text-column-command markup)
   (and (pair? markup) (procedure? (car markup)) (procedure-name (car markup))))
#(define (xml-text-column-markup-lines markup)
   (let* ((command (xml-text-column-command markup))
          (args (and command (cdr markup))))
     (and (memq command '(column-markup left-column-markup center-column-markup right-column-markup))
          (list? args) (= (length args) 1) (list? (car args))
          (pair? (car args)) (every string? (car args)) (car args))))
#(define (xml-text-column-event-listener event)
   (let ((lines (xml-text-column-markup-lines (ly:event-property event 'text #f)))
         (existing (ly:event-property event 'xml-text-column-id #f)))
     (and lines
       (if (integer? existing)
        (begin
         (set! xml-text-column-next (max xml-text-column-next existing))
         existing)
        (begin
         (set! xml-text-column-next (+ 1 xml-text-column-next))
         (ly:event-set-property! event 'xml-text-column-id xml-text-column-next)
         xml-text-column-next)))))
#(define (xml-text-column-glyph-tree? expression)
   (and (pair? expression)
     (cond
       ((eq? (car expression) 'glyph-string) #t)
       ((eq? (car expression) 'translate-stencil)
        (and (list? expression) (= (length expression) 3)
             (pair? (cadr expression)) (number? (caar (cdr expression)))
             (number? (cdar (cdr expression)))
             (finite? (caar (cdr expression))) (finite? (cdar (cdr expression)))
             (xml-text-column-glyph-tree? (caddr expression))))
       ((eq? (car expression) 'combine-stencil)
        (and (pair? (cdr expression)) (every xml-text-column-glyph-tree? (cdr expression))))
       (else #f))))
#(define (xml-text-column-leaves expression)
   (set! xml-text-column-stage 'leaf-tree)
   (let walk ((node expression) (x 0) (y 0))
     (if (not (pair? node)) #f
       (cond
        ((eq? (car node) 'translate-stencil)
         (let ((offset (and (list? node) (= (length node) 3) (cadr node))))
           (and (pair? offset) (xml-text-column-finite? (car offset))
                (xml-text-column-finite? (cdr offset))
                (walk (caddr node) (+ x (car offset)) (+ y (cdr offset))))))
        ((eq? (car node) 'combine-stencil)
         (set! xml-text-column-stage 'leaf-combine-map)
         (let ((children (map (lambda (child) (walk child x y)) (cdr node))))
           (and (pair? children) (every list? children) (apply append children))))
        ((eq? (car node) 'utf-8-string)
         (and (list? node) (= (length node) 4) (string? (caddr node))
              (xml-text-column-glyph-tree? (cadddr node))
              (list (vector (caddr node) x y))))
        (else #f)))))
#(define (xml-text-column-finite? value)
   (and (real? value) (finite? value)))
#(define (xml-text-column-role-leaves markup expression)
   (set! xml-text-column-stage 'role-leaves)
   (let ((lines (xml-text-column-markup-lines markup))
         (leaves (xml-text-column-leaves expression)))
     (and lines leaves (= (length lines) (length leaves))
          (every (lambda (line leaf) (equal? line (vector-ref leaf 0))) lines leaves)
          (set! xml-text-column-stage 'role-map)
          (map (lambda (line leaf) (list line (vector-ref leaf 1) (vector-ref leaf 2))) lines leaves))))
#(define (xml-text-column-project-lines leaves item-x left-x item-y staff-top factor)
   (let loop ((remaining leaves) (index 0) (result '()))
     (if (null? remaining)
         (reverse result)
         (let* ((leaf (car remaining))
                (line (list
                  (cons 'index index)
                  (cons 'text (car leaf))
                  (cons 'system-left-relative-x-tenths
                    (* factor (+ (- item-x left-x) (cadr leaf))))
                  (cons 'staff-top-y-tenths
                    (* factor (- (+ item-y (caddr leaf)) staff-top))))))
           (loop (cdr remaining) (+ index 1) (cons line result))))))
#(define (xml-text-column-cache-stencil grob original)
   (let ((stencil (original grob)))
     (when (ly:stencil? stencil) (hashq-set! xml-text-column-cache grob stencil))
     stencil))
#(define (xml-text-column-engraver ctx)
   (make-engraver
    (listeners
     ((text-script-event engraver event) (xml-text-column-event-listener event)))
    (acknowledgers
     ((staff-symbol-interface engraver item source)
      (when (and (eq? ctx (ly:translator-context source)) (ly:grob? item))
       (set! xml-text-column-staff-symbols
        (cons (cons (ed-context-id ctx) item) xml-text-column-staff-symbols))))
     ((text-script-interface engraver grob source)
      (when (and (eq? ctx (ly:translator-context source)) (ly:item? grob)
                 (eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'TextScript))
       (let* ((cause (ly:grob-property grob 'cause #f))
              (id (and (ly:stream-event? cause) (ly:event-property cause 'xml-text-column-id #f)))
              (markup (and (ly:stream-event? cause) (ly:event-property cause 'text #f)))
              (printer (ly:grob-property-data grob 'stencil))
              (before (ly:grob-property-data grob 'before-line-breaking))
              (after (ly:grob-property-data grob 'after-line-breaking)))
         (when (and (integer? id) (xml-text-column-markup-lines markup)
                    (eq? printer ly:text-interface::print)
                    (or (not before) (null? before))
                    (or (not after) (null? after)))
           (set! xml-text-column-originals
             (cons (list grob cause ctx id markup printer
                         (ly:context-property ctx 'rootSystem #f))
                   xml-text-column-originals))
           (ly:grob-set-property! grob 'stencil
             (lambda (actual) (xml-text-column-cache-stencil actual printer))))))))))
#(define (xml-final-text-column-positions)
   (set! xml-text-column-stage 'outer-position-map)
   (filter identity
    (map
    (lambda (entry)
     (set! xml-text-column-stage 'position-entry)
     (let* ((grob (list-ref entry 0)) (cause (list-ref entry 1)) (ctx (list-ref entry 2))
            (id (list-ref entry 3)) (markup (list-ref entry 4))
            (stencil (hashq-ref xml-text-column-cache grob #f))
            (system (and (ly:stencil? stencil) (ly:grob-system grob)))
            (root-system (list-ref entry 6))
            (systems (if (ly:grob? root-system) (xml-geometry-broken-pieces root-system) '()))
            (system-index (and (ly:grob? system) (list-index (lambda (candidate) (eq? candidate system)) systems)))
            (staff-object (and (ly:grob? grob) (ly:grob-object grob 'staff-symbol #f)))
            (staff-pieces (if (and (ly:grob? staff-object) (ly:grob? system))
              (filter (lambda (candidate) (eq? (ly:grob-system candidate) system)) (xml-geometry-broken-pieces staff-object)) '()))
            (staff (and (= (length staff-pieces) 1) (car staff-pieces)))
            (staff-owners (if (ly:grob? staff)
              (filter (lambda (row) (or (eq? (cdr row) staff) (eq? (cdr row) (ly:grob-original staff)))) xml-text-column-staff-symbols) '()))
            (column (and (ly:item? grob) (ly:item-get-column grob)))
            (moment (and (ly:grob? column) (ly:grob-property-data column 'when)))
            (positions (and staff (ly:grob-property-data staff 'line-positions)))
            (space (and stencil (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f)))
            (output-scale (and stencil (ly:output-def-lookup (ly:grob-layout grob) 'output-scale #f)))
            (staff-space (and staff (ly:staff-symbol-staff-space staff)))
            (staff-top (and (pair? positions) (every xml-text-column-finite? positions)
              (xml-text-column-finite? staff-space)
              (+ (ly:grob-relative-coordinate staff system Y) (xml-geometry-render-extra staff Y)
                 (* 0.5 staff-space (apply max positions)))))
            (system-left (and (ly:grob? system) (ly:spanner-bound system LEFT)))
            (left-x (and (ly:grob? system-left) (+ (ly:grob-relative-coordinate system-left system X)
                                                    (xml-geometry-render-extra system-left X))))
            (item-x (and (ly:grob? system) (+ (ly:grob-relative-coordinate grob system X) (xml-geometry-render-extra grob X))))
            (item-y (and (ly:grob? system) (+ (ly:grob-relative-coordinate grob system Y) (xml-geometry-render-extra grob Y))))
            (leaves (begin (set! xml-text-column-stage 'resolve-stencil-leaves)
              (and (ly:stencil? stencil) (xml-text-column-role-leaves markup (ly:stencil-expr stencil)))))
            (layout-space (and (xml-text-column-finite? space) (> space 0) space))
            (global-mm (and (xml-text-column-finite? output-scale) (> output-scale 0)
                            layout-space (* output-scale layout-space)))
            (valid? (and system-index staff (= (length staff-owners) 1) (ly:moment? moment)
                         (xml-text-column-finite? staff-top) (xml-text-column-finite? left-x)
                         (xml-text-column-finite? item-x) (xml-text-column-finite? item-y)
                         (xml-text-column-finite? layout-space) (xml-text-column-finite? global-mm)
                         (pair? leaves) (grob::is-live? grob)))
            (factor (and valid? (* output-scale 10 (/ 1 global-mm))))
            (lines (begin (set! xml-text-column-stage 'project-lines)
              (and valid? (xml-text-column-project-lines leaves item-x left-x item-y staff-top factor)))))
       (and valid? (list
        `(m . ,(ly:moment-main moment)) `(g . ,(ly:moment-grace moment))
        `(k . textcolumnposition) `(id . ,id) `(context . ,(ed-context-id ctx))
        `(staff-context . ,(caar staff-owners)) `(system . ,(+ system-index 1))
        `(column-moment . ((main . ,(ly:moment-main moment)) (grace . ,(ly:moment-grace moment))) )
        `(column-m . ,(ly:moment-main moment)) `(column-g . ,(ly:moment-grace moment))
        `(units . "system-left/staff-top-global-tenths")
        `(system-left-origin-x-tenths . ,(* factor left-x))
        `(output-scale . ,output-scale) `(global-layout-staff-space . ,layout-space)
        `(global-staff-space-mm . ,global-mm)
        `(lines . ,(list->vector lines))))))
    (reverse xml-text-column-originals))))
#(define (xml-finish-text-column-positions!)
   (for-each (lambda (event) (set! ed-events (cons event ed-events)))
     (filter identity (xml-final-text-column-positions))))

\layout {
  \context { \Voice \consists #xml-text-column-engraver }
  \context { \CueVoice \consists #xml-text-column-engraver }
  \context { \DrumVoice \consists #xml-text-column-engraver }
  \context { \TabVoice \consists #xml-text-column-engraver }
  \context { \Staff \consists #xml-text-column-engraver }
  \context { \DrumStaff \consists #xml-text-column-engraver }
  \context { \TabStaff \consists #xml-text-column-engraver }
}

% Score lifecycle owned by this collector.
#(xml-define-collector-state text-columns layout
 (xml-text-column-next xml-text-column-stage xml-text-column-originals xml-text-column-cache xml-text-column-staff-symbols)
 (reset (xml-reset-text-columns!))
 (clear (xml-clear-text-columns!)))
