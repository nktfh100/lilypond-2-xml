% Actual Lyrics-owned graphic transitions; no inferred sung pitch movement.
#(define xml-vowel-transition-originals '())
#(define xml-vowel-transition-syllables '())
#(define xml-vowel-transition-heard '())
#(define xml-vowel-transition-count 0)
#(define xml-vowel-transition-syllable-count 0)
#(define (xml-clear-vowel-transitions!)
   (set! xml-vowel-transition-originals '())
   (set! xml-vowel-transition-syllables '())
   (set! xml-vowel-transition-heard '()))
#(define (xml-reset-vowel-transitions!)
   (xml-clear-vowel-transitions!)
   (set! xml-vowel-transition-count 0)
   (set! xml-vowel-transition-syllable-count 0))
#(define (xml-vowel-transition-engraver ctx)
   (make-engraver
    (listeners
     ((vowel-transition-event engraver event)
      (let ((voice (ly:context-property ctx 'associatedVoiceContext #f)))
       (ed-push! ctx `((k . vowel-transition-request) (verse . ,(ed-context-id ctx))
         (voice . ,(if (ly:context? voice) (ed-context-id voice) 'null))))))
     ((lyric-event engraver event)
      (set! xml-vowel-transition-heard
       (cons (list event (ed-context-id ctx) (ly:context-current-moment ctx))
             xml-vowel-transition-heard))))
    (acknowledgers
     ((lyric-syllable-interface engraver grob source)
      (when (and (eq? ctx (ly:translator-context source))
                 (eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'LyricText))
       (let* ((cause (ly:grob-property grob 'cause #f))
              (heard (filter (lambda (entry) (and (eq? cause (car entry))
                (= (cadr entry) (ed-context-id ctx))
                (equal? (caddr entry) (ly:context-current-moment ctx)))) xml-vowel-transition-heard))
              (voice (ly:context-property ctx 'associatedVoiceContext #f))
              (staff (and (ly:context? voice) (xml-script-staff voice))))
         (set! xml-vowel-transition-syllable-count (+ 1 xml-vowel-transition-syllable-count))
         (set! xml-vowel-transition-syllables
          (cons (list grob (ed-context-id ctx) (and (= (length heard) 1) (caddr (car heard)))
             xml-vowel-transition-syllable-count
             (and (ly:context? voice) (ed-context-id voice))
             (and (ly:context? staff) (ed-context-id staff)))
            xml-vowel-transition-syllables)))))
     ((lyric-interface engraver grob source)
      (when (and (eq? ctx (ly:translator-context source))
                 (eq? (assoc-get 'name (ly:grob-property grob 'meta)) 'VowelTransition))
       (set! xml-vowel-transition-count (+ 1 xml-vowel-transition-count))
       (xml-geometry-observe-root! ctx)
       (set! xml-vowel-transition-originals
        (cons (list grob xml-vowel-transition-count (ed-context-id ctx)
          (ly:context-current-moment ctx) (xml-bracket-stencil grob)
          (ly:grob-property-data grob 'after-line-breaking)) xml-vowel-transition-originals)))))
    ((stop-translation-timestep engraver)
     (let* ((voice (ly:context-property ctx 'associatedVoiceContext #f))
            (owner (and (ly:context? voice) (xml-script-staff voice))))
      (when (ly:context? owner) (xml-observe-line-measure! owner))))))

#(define (xml-vowel-transition-syllable bound verse)
   (and (ly:grob? bound)
     (find (lambda (row) (and (= (cadr row) verse)
       (or (eq? bound (car row)) (eq? (ly:grob-original bound) (car row)))))
      xml-vowel-transition-syllables)))
% Decode only the actual standard horizontal shaft and triangular arrow primitives.
#(define (xml-vowel-transition-primitives expr dx dy)
   (cond
    ((and (list? expr) (= (length expr) 3) (eq? (car expr) 'translate-stencil)
       (pair? (cadr expr)) (number? (caadr expr)) (number? (cdadr expr)))
     (xml-vowel-transition-primitives (caddr expr) (+ dx (caadr expr)) (+ dy (cdadr expr))))
    ((and (pair? expr) (eq? (car expr) 'combine-stencil))
     (let ((children (map (lambda (child) (xml-vowel-transition-primitives child dx dy)) (cdr expr))))
      (and (every list? children) (append-map identity children))))
    ((xml-line-points expr dx dy) => (lambda (points)
      (and (= (cdar points) (cdr (cadr points))) (list (cons 'line points)))))
    ((and (list? expr) (= (length expr) 4) (eq? (car expr) 'polygon)
       (list? (cadr expr)) (= (length (cadr expr)) 6) (every number? (cadr expr))
       (= (list-ref (cadr expr) 0) (list-ref (cadr expr) 2))
       (< (abs (- (+ (list-ref (cadr expr) 1) (list-ref (cadr expr) 3))
          (* 2 (list-ref (cadr expr) 5)))) 1e-8))
     (list (cons 'arrow (cons (+ dx (list-ref (cadr expr) 4)) (+ dy (list-ref (cadr expr) 5))))))
    (else #f)))
#(define (xml-vowel-transition-points stencil arrows)
   (let* ((parts (xml-vowel-transition-primitives (ly:stencil-expr stencil) 0 0))
          (shafts (and parts (filter (lambda (p) (eq? (car p) 'line)) parts)))
          (tips (and parts (sort (map cdr (filter (lambda (p) (eq? (car p) 'arrow)) parts))
                           (lambda (a b) (< (car a) (car b)))))))
     (and shafts (= (length shafts) 1) (= (length tips) (count identity arrows))
       (let* ((shaft (cdar shafts)) (a (car shaft)) (b (cadr shaft))
              (left (if (car arrows) (car tips) a))
              (right (if (cadr arrows) (car (reverse tips)) b)))
         (and (<= (car left) (car a)) (>= (car right) (car b))
           (= (cdr left) (cdr a)) (= (cdr right) (cdr b)) (list left right))))))
#(define (xml-final-vowel-transitions)
   (append-map
    (lambda (entry)
     (let* ((original (car entry)) (verse (list-ref entry 2))
            (from (xml-vowel-transition-syllable (ly:spanner-bound original LEFT #f) verse))
            (to (xml-vowel-transition-syllable (ly:spanner-bound original RIGHT #f) verse))
            (same-owner (and from to (list-ref from 4) (list-ref from 5)
              (equal? (list-ref from 4) (list-ref to 4))
              (equal? (list-ref from 5) (list-ref to 5))))
            (voice (and same-owner (list-ref from 4)))
            (owner (and same-owner (list-ref from 5)))
            (piece 0))
      (map (lambda (grob)
       (set! piece (+ 1 piece))
       (let* ((left (xml-duration-bound (ly:spanner-bound grob LEFT #f)))
              (right (xml-duration-bound (ly:spanner-bound grob RIGHT #f)))
              (start (and left (cadr left))) (end (and right (cadr right)))
              (moment (if (ly:moment? start) start (list-ref entry 3)))
              (raw (list-ref entry 4)) (after (list-ref entry 5))
              (standard (or (eq? raw #f) (eq? raw ly:line-spanner::print)))
              (stencil (ly:grob-property grob 'stencil #f))
              (live (and (grob::is-live? grob) (ly:stencil? stencil) (not (ly:stencil-empty? stencil))))
              (info (if live (list (ly:grob-property grob 'left-bound-info '())
                                  (ly:grob-property grob 'right-bound-info '())) (list '() '())))
              (custom (or (not standard)
                (not (or (eq? after #f) (null? after) (eq? after ly:spanner::kill-zero-spanned-time)))
                (any (lambda (edge) (assoc-get 'stencil edge #f)) info)))
              (arrows (map (lambda (edge) (eq? (assoc-get 'arrow edge #f) #t)) info))
              (space (ly:output-def-lookup (ly:grob-layout grob) 'staff-space #f))
              (system (ly:grob-system grob))
              (points (and live standard (not custom) (xml-vowel-transition-points stencil arrows)))
              (scale (and (number? space) (> space 0) (/ 10 space)))
              (staff (and owner (xml-geometry-unique-staff system owner)))
              (top (xml-geometry-staff-top staff system))
              (origins (list (and owner (xml-line-origin system start owner))
                             (and owner (xml-line-origin system end owner))))
              (x (if (and points scale (ly:grob? system))
                (map (lambda (point origin) (if origin (* scale
                  (- (+ (car point) (ly:grob-relative-coordinate grob system X) (xml-geometry-render-extra grob X))
                     (ly:grob-relative-coordinate (car origin) system X))) 'null)) points origins) '(null null)))
              (y (if (and points scale top (ly:grob? system))
                (map (lambda (point) (* scale (- (+ (cdr point) (ly:grob-relative-coordinate grob system Y)
                  (xml-geometry-render-extra grob Y)) top))) points) '(null null))))
        `((k . vowel-transition) (id . ,(cadr entry)) (piece . ,piece) (verse . ,verse)
          (voice . ,(or voice 'null)) (s . ,(or owner 'null))
          (m . ,(ly:moment-main moment)) (g . ,(ly:moment-grace moment))
          (resolved-start . ,(ly:moment? start))
          (end-m . ,(if (ly:moment? end) (ly:moment-main end) 'null))
          (end-g . ,(if (ly:moment? end) (ly:moment-grace end) 'null))
          (left-kind . ,(if left (car left) 'null)) (right-kind . ,(if right (car right) 'null))
          (from-lyric-id . ,(if from (list-ref from 3) 'null))
          (to-lyric-id . ,(if to (list-ref to 3) 'null))
          (from-lyric-m . ,(if (and from (ly:moment? (caddr from))) (ly:moment-main (caddr from)) 'null))
          (from-lyric-g . ,(if (and from (ly:moment? (caddr from))) (ly:moment-grace (caddr from)) 'null))
          (to-lyric-m . ,(if (and to (ly:moment? (caddr to))) (ly:moment-main (caddr to)) 'null))
          (to-lyric-g . ,(if (and to (ly:moment? (caddr to))) (ly:moment-grace (caddr to)) 'null))
          (style . ,(ed-value (ly:grob-property grob 'style 'line)))
          (color . ,(xml-color (ly:grob-property grob 'color #f)))
          (hidden . ,(or (eq? raw #f) (not live) (eq? (ly:grob-property grob 'transparent #f) #t)))
          (custom . ,(if custom #t #f))
          (left-arrow . ,(car arrows)) (right-arrow . ,(cadr arrows))
          (x-tenths . ,(list->vector x)) (y-tenths . ,(list->vector y))
          (x-ref-m . ,(list->vector (map (lambda (o) (if o (ly:moment-main (cdr o)) 'null)) origins)))
          (x-ref-g . ,(list->vector (map (lambda (o) (if o (ly:moment-grace (cdr o)) 'null)) origins)))
          (staff-space . ,(ly:staff-symbol-staff-space grob))
          (layout-staff-space . ,(or space 'null))
          (dash-fraction . ,(ly:grob-property grob 'dash-fraction .4))
          (dash-period . ,(ly:grob-property grob 'dash-period 1))
          (arrow-length . ,(ly:grob-property grob 'arrow-length 'null))
          (arrow-width . ,(ly:grob-property grob 'arrow-width 'null)))))
       (xml-geometry-broken-pieces original))))
    (reverse xml-vowel-transition-originals)))
\layout { \context { \Lyrics \consists #xml-vowel-transition-engraver } }

% Score lifecycle owned by this collector.
#(xml-define-collector-state vowel-transitions layout
 (xml-vowel-transition-originals xml-vowel-transition-syllables xml-vowel-transition-heard xml-vowel-transition-count xml-vowel-transition-syllable-count)
 (reset (xml-reset-vowel-transitions!))
 (clear (xml-clear-vowel-transitions!)))
