{
  "name": "lilypond-2-xml",
  "version": "0.1.0",
  "description": "Nearly lossless LilyPond to MusicXML conversion for Node.js and the browser.",
  "author": "nktfh100",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nktfh100/lilypond-2-xml.git"
  },
  "homepage": "https://github.com/nktfh100/lilypond-2-xml#readme",
  "bugs": {
    "url": "https://github.com/nktfh100/lilypond-2-xml/issues"
  },
  "keywords": [
    "lilypond",
    "musicxml",
    "music-notation",
    "converter",
    "wasm"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "tools",
    "patches",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && patch-package --error-on-fail && tsx tools/build-listener.ts --check && tsc -p tsconfig.build.json",
    "build:listener": "patch-package --error-on-fail && tsx tools/build-listener.ts",
    "evaluate": "tsx tools/evaluation/cli.ts",
    "format": "eslint --fix . && prettier --write .",
    "format:check": "prettier --check . && npm run lint",
    "lint": "eslint .",
    "lint:fix": "npm run format",
    "test": "npm run build && tsx tools/test/run.ts all",
    "test:browser": "npm run build && vite build && playwright test",
    "test:compiler": "npm run build && tsx tools/test/run.ts compiler",
    "test:coverage": "npm run build && c8 tsx tools/test/run.ts all",
    "test:fast": "npm run build && tsx tools/test/run.ts fast",
    "test:native": "npm run build && tsx tools/test/run.ts native",
    "test:types": "npm run build && tsc --noEmit",
    "check:release": "npm run format:check && npm run build && tsc --noEmit && c8 tsx tools/test/run.ts node && vite build && playwright test && c8 --clean=false tsx tools/test/run.ts native && npm pack --dry-run --ignore-scripts",
    "prepack": "npm run build"
  },
  "c8": {
    "all": true,
    "src": [
      "dist"
    ],
    "include": [
      "src/**/*.ts",
      "dist/**/*.js"
    ],
    "exclude": [
      "{src,dist}/api/types.{ts,js}",
      "{src,dist}/lilypond/generated/**",
      "{src,dist}/lilypond/wire.{ts,js}",
      "{src,dist}/model/{diagnostics,document}.{ts,js}",
      "{src,dist}/musicxml/**/{types,context}.{ts,js}"
    ],
    "reporter": [
      "text-summary",
      "html",
      "lcov"
    ]
  },
  "dependencies": {
    "@sightread/lilypond-eventdocument": "0.1.1",
    "@sightread/lilypond-wasm": "0.2.0",
    "xmlbuilder2": "4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "c8": "10.1.3",
    "eslint": "10.12.0",
    "libxml2-wasm": "0.7.2",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "verovio": "6.3.0",
    "vite": "7.3.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
